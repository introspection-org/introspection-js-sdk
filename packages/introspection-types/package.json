{
  "name": "@introspection-sdk/types",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/introspection-org/introspection-js-sdk.git",
    "directory": "packages/introspection-types"
  },
  "description": "Shared types for the Introspection JavaScript SDK",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./logs": {
      "types": "./dist/logs.d.ts",
      "default": "./dist/logs.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "clean": "rm -rf dist",
    "prepare": "rm -rf dist && tsc",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@repo/typescript-config": "workspace:*",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0",
    "@opentelemetry/api-logs": ">=0.200.0",
    "@opentelemetry/sdk-logs": ">=0.200.0",
    "@opentelemetry/sdk-trace-base": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/api-logs": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    }
  }
}
