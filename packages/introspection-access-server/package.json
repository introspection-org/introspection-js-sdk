{
  "name": "@introspection-sdk/access-server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/introspection-org/introspection-js-sdk.git",
    "directory": "packages/introspection-access-server"
  },
  "description": "An AAuth Access Server (draft-hardt-oauth-aauth-protocol -11, four-party): a resource's own policy over the auth tokens Person Servers redeem for it, as Request \u2192 Response handlers",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "build": "rm -rf dist && tsc",
    "clean": "rm -rf dist",
    "prepare": "rm -rf dist && tsc",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@aauth/resource": "^3.0.0",
    "@introspection-sdk/person-server": "workspace:*",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "5.9.3"
  }
}
