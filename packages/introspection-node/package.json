{
  "name": "@introspection-sdk/introspection-node",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Introspection observability SDK for Node.js",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./otel/pi": {
      "types": "./dist/otel/pi.d.ts",
      "default": "./dist/otel/pi.js"
    },
    "./otel/register": {
      "types": "./dist/otel/register.d.ts",
      "default": "./dist/otel/register.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "build": "rm -rf dist && tsc",
    "prepare": "rm -rf dist && tsc",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.75.0",
    "@opentelemetry/api-logs": ">=0.50.0",
    "@opentelemetry/context-async-hooks": ">=1.20.0 || >=2.0.0",
    "@opentelemetry/core": ">=1.20.0 || >=2.0.0",
    "@opentelemetry/exporter-logs-otlp-proto": ">=0.50.0",
    "@opentelemetry/exporter-trace-otlp-proto": ">=0.50.0",
    "@opentelemetry/resources": ">=1.20.0 || >=2.0.0",
    "@opentelemetry/sdk-logs": ">=0.50.0",
    "@opentelemetry/sdk-trace-base": ">=1.20.0 || >=2.0.0",
    "@opentelemetry/sdk-trace-node": ">=1.20.0 || >=2.0.0",
    "@opentelemetry/semantic-conventions": ">=1.20.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@opentelemetry/api-logs": {
      "optional": true
    },
    "@opentelemetry/context-async-hooks": {
      "optional": true
    },
    "@opentelemetry/core": {
      "optional": true
    },
    "@opentelemetry/exporter-logs-otlp-proto": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-proto": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-logs": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-node": {
      "optional": true
    },
    "@opentelemetry/semantic-conventions": {
      "optional": true
    }
  },
  "dependencies": {
    "@introspection-sdk/http": "workspace:*",
    "@introspection-sdk/introspection-pi": "workspace:*",
    "@introspection-sdk/introspection-proxy": "workspace:*",
    "@introspection-sdk/types": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "https-proxy-agent": "^7.0.6",
    "proxy-from-env": "^2.1.0"
  }
}
