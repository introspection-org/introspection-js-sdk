# Introspection SDK
INTROSPECTION_TOKEN=your_introspection_token
INTROSPECTION_BASE_OTEL_URL=https://otel.introspection.dev

# Anthropic (for the Pi examples' Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Dual export (optional) — Pi spans fan out to these alongside Introspection.
# Langfuse: set LANGFUSE_BASE_URL to https://us.cloud.langfuse.com for US.
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
BRAINTRUST_API_KEY=your_braintrust_api_key
