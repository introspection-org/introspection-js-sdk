# Introspection SDK
INTROSPECTION_TOKEN=your_introspection_token
INTROSPECTION_BASE_OTEL_URL=https://otel.introspection.dev

# Anthropic (for the Pi examples' Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Dual export (optional) — Pi spans fan out to this collector alongside
# Introspection. Headers use the standard "key=value,key2=value2" form.
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector.example.com
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer your_token
