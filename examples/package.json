    "@types/node": "^22.20.1",
    "mcporter": "^0.13.0",
    "tsx": "^4.23.10",
    "typescript": "^5.9.3",
    "typesense": "^3.0.6"
  },
  "optionalDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0"
  }
