{
  "name": "introspection-examples",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "pi-native": "node --import tsx otel/pi/native.ts",
    "pi-init": "node --import tsx otel/pi/init.ts",
    "pi-dual-export": "node --import tsx otel/pi/dual-export.ts",
    "pi-subagents": "node --import tsx otel/pi/subagents.ts",
    "api-runtimes": "node --import tsx api/runtimes.ts",
    "proxy-supabase-global": "node --import tsx proxy/supabase-global.ts",
    "proxy-supabase-manual": "node --import tsx proxy/supabase-manual.ts",
    "proxy-typesense": "node --import tsx proxy/typesense.ts",
    "proxy-deepwiki": "node --import tsx proxy/deepwiki-mcp.ts",
