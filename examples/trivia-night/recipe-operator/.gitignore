# Generated Pi runtime state
.pi/bin/
.pi/mcp-session.json
.pi/mcporter.json
.introspection/local.json

# Dependencies
node_modules/

# Secrets. `introspection dev` stages with `git add -A`, so anything untracked
# and un-ignored here travels to the cloud inside the development patch.
.env
.env.*

# Eval run output from `introspection eval run`
eval-runs/

# Local runs against the fakes
.introspection/local/

# A same-day agent key for platform evals
.agent.key

# Per-pub tasks generated by evals/venues.mjs for local Harbor runs; only night0/night1/night2 are committed.
evals/harbor/*-*/
