{
  "name": "introspection-example-aauth-travel",
  "version": "0.1.0",
  "private": true,
  "description": "Flight Sector, an AAuth demo: a travel agent books company travel from a chat over AAuth inside each customer's own policy, escalating to the manager when it must. Hosts Flight Sector's booking provider and Acme's Person Server, and walks through every step beside the code behind it.",
  "scripts": {
    "dev": "scripts/dev.sh",
    "e2e": "node scripts/e2e.mjs",
    "build": "next build",
    "start": "next start --port 3400",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "walkthrough": "node scripts/walkthrough.mjs && prettier --write WALKTHROUGH.md",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@aauth/resource": "^3.0.0",
    "@hellocoop/httpsig": "^2.6.0",
    "@introspection-sdk/aauth-resource": "workspace:*",
    "@introspection-sdk/introspection-node": "workspace:*",
    "@introspection-sdk/person-server": "workspace:*",
    "jose": "^6.2.12",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^3.13.0"
  },
  "devDependencies": {
    "@aauth/agent": "^4.1.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5.7.2"
  }
}
