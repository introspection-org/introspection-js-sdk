# Each party is its own AAuth server, and an identifier is https://host with
# no port or path. `pnpm dev` gives each a public https URL through Cloudflare
# and writes APP_URL, BOOKING_ISSUER and BROWSERBASE_MCP_URL (and, with
# PERSON_SERVER=acme, ACME_PERSON_SERVER_URL) here.
#
# Without a domain, those are quick tunnels: free, no account, a new
# *.trycloudflare.com each run. With a domain in your Cloudflare account
# (`cloudflared tunnel login` once), a named tunnel's hosts, the same every run:
# FLIGHTSECTOR_DOMAIN=example.dev
APP_URL=http://localhost:3400

# Flight Sector's booking provider, an AAuth resource. It serves the people of
# these Person Servers (comma-separated; default: Acme's).
BOOKING_ISSUER=https://booking.flightsector.localhost
BOOKING_PERSON_SERVERS=

# Optional PKCS#8 Ed25519 PEMs to keep signing keys stable across restarts.
BOOKING_SIGNING_KEY=
ACME_PS_SIGNING_KEY=

# Which Person Server speaks for Acme's people: acme (Acme's own, here) or
# hosted (Introspection's, with Acme's approval app deciding through the
# platform).
PERSON_SERVER=acme
HOSTED_PERSON_SERVER_URL=
# Hosted only: the data plane Acme's approval app calls, Acme's org, and an
# API key of Acme's project there (approvals:read and approvals:write).
ACME_INTROSPECTION_URL=
ACME_ORG_ID=
ACME_INTROSPECTION_TOKEN=

# Acme's Person Server, and where its approval page lives in either mode.
ACME_PERSON_SERVER_URL=https://ps.acme.localhost
# Keys Acme derives each person's per-audience pseudonym from. Unset, a fresh
# secret per process.
ACME_PS_SUBJECT_SECRET=
# Agent Providers whose agents may act here (comma-separated). `pnpm dev` sets
# it to the control plane you are logged in to. Add https://e2e-agents.localhost
# for the e2e script.
TRUSTED_AGENT_PROVIDERS=https://cp.introspection.localhost
# Resources whose resource tokens Acme accepts (comma-separated). Default: the
# booking provider.
ACME_TRUSTED_RESOURCES=

# How Acme emails Dana. Without a Resend key the email is printed to the
# server console instead.
RESEND_API_KEY=
ACME_MAIL_FROM=Acme Travel Approvals <approvals@acme.example>

# On a real Slack workspace: the presenter's workspace and user id for Sam,
# and the inbox Dana's approval emails go to.
ACME_WORKSPACE_ID=
ACME_SAM_USER_ID=
ACME_DANA_EMAIL=

# Reads the recipe for the walkthrough while its repository is private (flow/recipe.mjs).
GITHUB_TOKEN=
