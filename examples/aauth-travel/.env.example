# Each party is its own AAuth server, and an identifier is https://host with
# no port or path. Locally portless serves these hosts on this one process
# (see package.json); in production each is a host of its own.
APP_URL=https://flightsector.localhost

# Flight Sector's booking provider, an AAuth resource. It serves the people of
# these Person Servers (comma-separated; default: Acme's).
BOOKING_ISSUER=https://booking.flightsector.localhost
BOOKING_PERSON_SERVERS=

# Optional PKCS#8 Ed25519 PEMs to keep signing keys stable across restarts.
BOOKING_SIGNING_KEY=
ACME_PS_SIGNING_KEY=

# Acme's Person Server.
ACME_PERSON_SERVER_URL=https://ps.acme.localhost
# Keys Acme derives each person's per-audience pseudonym from. Unset, a fresh
# secret per process.
ACME_PS_SUBJECT_SECRET=
# Agent Providers whose agents may act here (comma-separated). Default: the
# local control plane. Add https://e2e-agents.localhost for the e2e script.
TRUSTED_AGENT_PROVIDERS=https://cp.introspection.localhost
# Resources whose resource tokens Acme accepts (comma-separated). Default: the
# booking provider.
ACME_TRUSTED_RESOURCES=

# How Acme emails Dana. Without a Resend key the email is printed to the
# server console instead.
RESEND_API_KEY=
ACME_MAIL_FROM=Acme Travel Approvals <approvals@acme.example>

# On a real Slack workspace: the presenter's workspace and user id for Sam,
# and the inbox Dana's approval emails go to.
ACME_WORKSPACE_ID=
ACME_SAM_USER_ID=
ACME_DANA_EMAIL=
