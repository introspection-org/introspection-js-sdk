# This app's own origin, for the parties it serves under a path.
APP_URL=http://localhost:3400

# Flight Sector's booking provider, an AAuth resource. Its metadata is at
# {BOOKING_ISSUER}/.well-known/aauth-resource.json, and it serves the people of
# these Person Servers (comma-separated; default: Acme's).
BOOKING_ISSUER=http://localhost:3400/booking
BOOKING_PERSON_SERVERS=
# Agent Providers whose agent tokens the provider accepts. Default outside
# production: the local control plane and the e2e test provider.
BOOKING_AGENT_PROVIDERS=

# Optional PKCS#8 PEMs to keep signing keys stable across restarts.
BOOKING_SIGNING_KEY=
ACME_PS_SIGNING_KEY=

# Acme's Person Server. An AAuth server identifier is scheme and host only, so
# it needs an origin of its own: 127.0.0.1 reaches this same process under a
# different host, and Next rewrites that host to /acme/*. In production this is
# e.g. https://ps.acme.example.
ACME_PERSON_SERVER_URL=http://127.0.0.1:3400
# Keys Acme derives each person's per-audience pseudonym from. Unset, a fresh
# secret per process.
ACME_PS_SUBJECT_SECRET=
# Agent providers Acme lets act for its people (comma-separated). Default
# outside production: the local control plane and the e2e test provider.
TRUSTED_AGENT_PROVIDERS=http://localhost:8000,http://localhost:3499
# Resources whose resource tokens Acme accepts (comma-separated). Default: the
# booking provider.
ACME_TRUSTED_RESOURCES=

# How Acme emails Dana. Without a Resend key the email is printed to the
# server console instead.
RESEND_API_KEY=
ACME_MAIL_FROM=Acme Travel Approvals <approvals@acme.example>

# On a real Slack workspace: the presenter's workspace and user id for Sam,
# and the inbox Dana's approval emails go to.
ACME_WORKSPACE_ID=
ACME_SAM_USER_ID=
ACME_DANA_EMAIL=
