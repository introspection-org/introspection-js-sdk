{
  "POST": "https://ps.acme.example/ps/token",
  "headers": {
    "Content-Type": "application/json",
    "Signature-Key": "sig=jwt;jwt=\"…(the same agent token)\"",
    "Signature": "sig=:…(the same session key):"
  },
  "body": {
    "resource_token": "eyJ…(from the provider's 401)",
    "presented_token": "eyJ…(the person token the provider saw)"
  },
  "answers": {
    "within_the_trip_budget": {
      "status": 200,
      "body": {
        "auth_token": "eyJ…",
        "expires_in": 3600
      }
    },
    "over_what_is_left": {
      "status": 202,
      "headers": {
        "Location": "https://ps.acme.example/ps/pending/0199…",
        "Retry-After": "5"
      }
    },
    "declined": {
      "status": 403,
      "body": {
        "type": "…/denied",
        "detail": "Dana Park declined"
      }
    },
    "no_mission": {
      "status": 403,
      "body": {
        "error": "access_denied",
        "error_description": "Acme books travel only under an approved trip"
      }
    }
  },
  "note": "Egress makes this call as the agent: signed with the session key, presenting the agent token. Acme fetches the proposal at r3_uri, checks it against r3_s256, and weighs the quote against what is left of the mission's budget."
}
