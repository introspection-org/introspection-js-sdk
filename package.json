{
  "name": "pwd",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=introspection-example-aauth-travel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "lint:limits": "turbo run lint --filter=./packages/*",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "jscpd": "npx --yes jscpd@5.4.1",
    "jscpd:renamed": "npx --yes jscpd@5.4.1 --kind renamed --ignore-identifiers",
    "check-types": "turbo run check-types",
    "check:doc-regions": "node scripts/check-doc-regions.mjs",
    "check-cycles": "madge --circular --extensions ts packages/*/src",
    "check:packages": "pnpm -r --filter \"./packages/*\" run check:package",
    "knip": "knip",
    "knip:production": "knip --production",
    "pre-commit": "pnpm lint && pnpm format:check && pnpm check-types",
    "prepare": "husky install",
    "test": "pnpm --filter introspection-tests test",
    "test:replay": "pnpm --filter introspection-tests test:replay",
    "test:record": "pnpm --filter introspection-tests test:record",
    "test:walk": "pnpm --filter introspection-tests test:walk",
    "test:walk:record": "pnpm --filter introspection-tests test:walk:record",
    "test:walk:live": "pnpm --filter introspection-tests test:walk:live",
    "test:walk:cov": "pnpm --filter introspection-tests test:walk:cov"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@repo/eslint-config": "workspace:^",
    "eslint": "^9.39.5",
    "husky": "^9.0.0",
    "knip": "6.42.1",
    "lint-staged": "^15.2.0",
    "madge": "8.0.0",
    "prettier": "^3.9.10",
    "publint": "0.3.25",
    "turbo": "^2.11.10",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/sdk-trace-base": "^2.0.1"
    }
  }
}
