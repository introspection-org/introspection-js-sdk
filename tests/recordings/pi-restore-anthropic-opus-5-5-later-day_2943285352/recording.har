            "text": "{\"model\":\"claude-opus-5-5\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"What is the weather in Tokyo? Use get_weather, then answer in one short sentence.\"}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01XKT6ajqSzeSC4ZVSReEKwU\",\"name\":\"get_weather\",\"input\":{\"city\":\"Tokyo\"}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01XKT6ajqSzeSC4ZVSReEKwU\",\"content\":\"Tokyo: clear\\n25°C, wind 10 km/h\",\"is_error\":false}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"It's clear in Tokyo right now, 25°C with a light 10 km/h wind.\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Is that warm? One word.\"}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"I'm noting that 25°C counts as warm, and I'll answer with that one word.\\n\\n\",\"signature\":\"\"},{\"type\":\"text\",\"text\":\"Yes.\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Should I bring an umbrella? One word.\"}]},{\"role\":\"system\",\"content\":[{\"type\":\"text\",\"text\":\"Updated system prompt section \\\"current_date\\\":\\n\\n<current_date>\\n2026-03-02\\n</current_date>\"}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"The date has rolled over to the next day, so the weather data I have is from yesterday. The user only wants one word, and clear skies point to \\\"No,\\\" but since the date moved on, the conditions might have changed, so I'll re-check by calling get_weather again.\\n\\n\",\"signature\":\"\"},{\"type\":\"tool_use\",\"id\":\"toolu_017Zb1dcoUDFZLsGfUJiDSsc\",\"name\":\"get_weather\",\"input\":{\"city\":\"Tokyo\"}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_017Zb1dcoUDFZLsGfUJiDSsc\",\"content\":\"Tokyo: clear\\n25°C, wind 10 km/h\",\"is_error\":false,\"cache_control\":{\"type\":\"ephemeral\"}}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}}],\"max_tokens\":128000,\"stream\":true,\"system\":[{\"type\":\"text\",\"text\":\"You are a weather assistant. Answer briefly.\\n\\n<addendum>\\nReference for pi-restore-anthropic-opus-5-5-later-day: the weather desk's station catalog. Use it only when asked.\\n- Station 1: code WX001, elevation 0 m, reports hourly.\\n- Station 2: code WX002, elevation 37 m, reports hourly.\\n- Station 3: code WX003, elevation 74 m, reports hourly.\\n- Station 4: code WX004, elevation 111 m, reports hourly.\\n- Station 5: code WX005, elevation 148 m, reports hourly.\\n- Station 6: code WX006, elevation 185 m, reports hourly.\\n- Station 7: code WX007, elevation 222 m, reports hourly.\\n- Station 8: code WX008, elevation 259 m, reports hourly.\\n- Station 9: code WX009, elevation 296 m, reports hourly.\\n- Station 10: code WX010, elevation 333 m, reports hourly.\\n- Station 11: code WX011, elevation 370 m, reports hourly.\\n- Station 12: code WX012, elevation 407 m, reports hourly.\\n- Station 13: code WX013, elevation 444 m, reports hourly.\\n- Station 14: code WX014, elevation 481 m, reports hourly.\\n- Station 15: code WX015, elevation 518 m, reports hourly.\\n- Station 16: code WX016, elevation 555 m, reports hourly.\\n- Station 17: code WX017, elevation 592 m, reports hourly.\\n- Station 18: code WX018, elevation 629 m, reports hourly.\\n- Station 19: code WX019, elevation 666 m, reports hourly.\\n- Station 20: code WX020, elevation 703 m, reports hourly.\\n- Station 21: code WX021, elevation 740 m, reports hourly.\\n- Station 22: code WX022, elevation 777 m, reports hourly.\\n- Station 23: code WX0