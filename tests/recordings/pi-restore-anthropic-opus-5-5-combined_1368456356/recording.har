            "text": "{\"model\":\"claude-opus-5-5\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"What is the weather in Tokyo? Use get_weather, then answer in one short sentence.\"}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01PoEQCNK1ykJjTqJLw6PMGH\",\"name\":\"get_weather\",\"input\":{\"city\":\"Tokyo\"}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01PoEQCNK1ykJjTqJLw6PMGH\",\"content\":\"Tokyo: clear\\n25°C, wind 10 km/h\",\"is_error\":false}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"It's clear in Tokyo right now, 25°C with a 10 km/h wind.\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Now call get_weather for Tokyo and for Paris in parallel, in one step, then compare them in one sentence.\"}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01BVqZSoC7vr4mzvQqwoMSmB\",\"name\":\"get_weather\",\"input\":{\"city\":\"Tokyo\"}},{\"type\":\"tool_use\",\"id\":\"toolu_01P1WqdQF6pE5BnzHyHJ4iaz\",\"name\":\"get_weather\",\"input\":{\"city\":\"Paris\"}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01BVqZSoC7vr4mzvQqwoMSmB\",\"content\":\"Tokyo: clear\\n25°C, wind 10 km/h\",\"is_error\":false},{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01P1WqdQF6pE5BnzHyHJ4iaz\",\"content\":\"Weather service unavailable for Paris\",\"is_error\":true}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"I need to give an honest answer here, since the last attempt fell short.\\n\\n\",\"signature\":\"\"},{\"type\":\"text\",\"text\":\"I can't compare them because the weather service was unavailable for Paris; Tokyo is still clear at 25°C with a 10 km/h wind.\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"What time is it in Tokyo? Use get_time, then answer briefly.\"}]},{\"role\":\"system\",\"content\":[{\"type\":\"tool_addition\",\"tool\":{\"type\":\"tool_definition\",\"definition\":{\"name\":\"get_time\",\"description\":\"Get the local time in a city.\",\"eager_input_streaming\":true,\"input_schema\":{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}},\"required\":[\"city\"]}}},\"cache_control\":{\"type\":\"ephemeral\"}}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}}],\"max_tokens\":128000,\"stream\":true,\"system\":[{\"type\":\"text\",\"text\":\"You are a weather assistant. Answer briefly.\\n\\n<addendum>\\nReference for pi-restore-anthropic-opus-5-5-combined: the weather desk's station catalog. Use it only when asked.\\n- Station 1: code WX001, elevation 0 m, reports hourly.\\n- Station 2: code WX002, elevation 37 m, reports hourly.\\n- Station 3: code WX003, elevation 74 m, reports hourly.\\n- Station 4: code WX004, elevation 111 m, reports hourly.\\n- Station 5: code WX005, elevation 148 m, reports hourly.\\n- Station 6: code WX006, elevation 185 m, reports hourly.\\n- Station 7: code WX007, elevation 222 m, reports hourly.\\n- Station 8: code WX008, elevation 259 m, reports hourly.\\n- Station 9: code WX009, elevation 296 m, reports hourly.\\n- Station 10: code WX010, elevation 333 m, reports hourly.\\n- Station 11: code WX011, elevation 370 m, reports hourly.\\n- Station 12: code WX012, elevation 407 m, reports hourly.\\n- Station 13: code WX013, elevation 444 m, reports hourly.\\n- Station 14: code WX014, elevation 481 m, reports hourly.\\n- Station 15: code WX015, elevation 518 m, reports hourly.\\n- Station 16: code WX016, elevation 555 m, reports hourly.\\n- Station 17: code WX017, elevation 592 m, reports hourly.\\n- St