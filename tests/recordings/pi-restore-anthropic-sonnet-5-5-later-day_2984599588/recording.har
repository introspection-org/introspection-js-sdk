            "text": "{\"model\":\"claude-sonnet-5-5\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"What is the weather in Tokyo? Use get_weather, then answer in one short sentence.\"}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"low\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_015uN6f6fRZXtdrVsmXy6oNF\",\"name\":\"get_weather\",\"input\":{\"city\":\"Tokyo\"}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_015uN6f6fRZXtdrVsmXy6oNF\",\"content\":\"Tokyo: clear\\n25°C, wind 10 km/h\",\"is_error\":false}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"low\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Tokyo is clear and 25°C, with 10 km/h wind.\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Is that warm? One word.\"}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"low\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Yes.\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Should I bring an umbrella? One word.\"}]},{\"role\":\"system\",\"content\":[{\"type\":\"text\",\"text\":\"Updated system prompt section \\\"current_date\\\":\\n\\n<current_date>\\n2026-03-02\\n</current_date>\",\"cache_control\":{\"type\":\"ephemeral\"}}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"low\"}}],\"max_tokens\":128000,\"stream\":true,\"system\":[{\"type\":\"text\",\"text\":\"You are a weather assistant. Answer briefly.\\n\\n<addendum>\\nReference for pi-restore-anthropic-sonnet-5-5-later-day: the weather desk's station catalog. Use it only when asked.\\n- Station 1: code WX001, elevation 0 m, reports hourly.\\n- Station 2: code WX002, elevation 37 m, reports hourly.\\n- Station 3: code WX003, elevation 74 m, reports hourly.\\n- Station 4: code WX004, elevation 111 m, reports hourly.\\n- Station 5: code WX005, elevation