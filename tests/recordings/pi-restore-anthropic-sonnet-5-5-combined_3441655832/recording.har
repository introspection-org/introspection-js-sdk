            "text": "{\"model\":\"claude-sonnet-5-5\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"What is the weather in Tokyo? Use get_weather, then answer in one short sentence.\"}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01TtbjFt8NXWmQBTNz1WyXjU\",\"name\":\"get_weather\",\"input\":{\"city\":\"Tokyo\"}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01TtbjFt8NXWmQBTNz1WyXjU\",\"content\":\"Tokyo: clear\\n25°C, wind 10 km/h\",\"is_error\":false}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Tokyo is clear and 25°C, with 10 km/h wind.\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Now call get_weather for Tokyo and for Paris in parallel, in one step, then compare them in one sentence.\"}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01S3SzrPCWkAabmUESYPJEfo\",\"name\":\"get_weather\",\"input\":{\"city\":\"Tokyo\"}},{\"type\":\"tool_use\",\"id\":\"toolu_01Nt42b75Aph5MCLzXzEjivo\",\"name\":\"get_weather\",\"input\":{\"city\":\"Paris\"}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01S3SzrPCWkAabmUESYPJEfo\",\"content\":\"Tokyo: clear\\n25°C, wind 10 km/h\",\"is_error\":false},{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01Nt42b75Aph5MCLzXzEjivo\",\"content\":\"Weather service unavailable for Paris\",\"is_error\":true,\"cache_control\":{\"type\":\"ephemeral\"}}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}}],\"max_tokens\":128000,\"stream\":true,\"system\":[{\"type\":\"text\",\"text\":\"You are a weather assistant. Answer briefly.\\n\\n<addendum>\\nReference for pi-restore-anthropic-