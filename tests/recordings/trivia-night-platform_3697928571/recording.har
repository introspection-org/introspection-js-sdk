eff86a790009f4ed25dea000d6184dff26b56@sha256:1c44b765b546f28b702568fa58b1cfc9dd003d504e5d9288fe58ffbcdce784e4\",\"ports\":[],\"expose\":[],\"volumes\":[\"fakes-verifier:/verifier\"],\"environment\":{\"EVAL_SIMULATE_NIGHT\":\"1\",\"EVAL_SIMULATE_TEAMS\":\"5\",\"EVAL_SIMULATE_SCENARIO\":\"crowd-page-sydney\",\"EVAL_SIMULATE_MANIFEST_DIR\":\"/verifier\",\"EVAL_SIMULATE_SERIES_NIGHTS\":\"2\"},\"healthcheck\":{\"test\":[\"CMD\",\"node\",\"-e\",\"fetch('http://127.0.0.1:7353/health').then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))\"],\"disable\":false,\"retries\":30,\"timeout\":\"30s\",\"interval\":\"1s\",\"start_period\":\"0s\"}}}},\"commands\":true,\"identity\":{\"tags\":[\"simulation:r3577419069331577\",\"simulation:trivia-night\"],\"anonymous_id\":\"sim-r3577419069331577-sydney\"},\"verifier\":{\"command\":[\"sh\",\"/tests/test.sh\"],\"tests_path\":\"evals/harbor/night1-sydney/tests\",\"reward_path\":\"/logs/verifier/reward.json\",\"timeout_seconds\":120},\"task_path\":\"evals/harbor/night1-sydney\",\"task_prompt\":\"We're in Sydney, in Australia, and it's our first trivia night with you. Five teams tonight: Quizzly Bears, Les Quizerables, Trivia Newton-John, The Bondi Brainstormers and Opera House Party. From what I've seen, this crowd loves film. We've time for six short rounds of four questions: plan the night, fetch each round and read it out. The bank records the crowd's answers as you serve each round, so you won't get a sheet back: after each round, check round_summary to see how they did. I won't reply until the night is over, so run all six rounds straight through in this one go without waiting for me. After the sixth round that's the end of tonight: leave your notes ready for next week, as you would after the last round.\\n\",\"trivia_night\":{\"step\":\"sydney/night1-memory\",\"record\":{\"run\":\"r3577419069331577\",\"pubs\":\"development\",\"teams\":5,\"target\":{\"commit\":\"2a6d7605904912a1e7d38d414484df631648c92f\",\"runtime\":\"01a20a7c-077e-706