            "text": "{\"type\":\"file\",\"name\":\"task.toml\",\"path\":\"evals/harbor/night1-sydney/task.toml\",\"size\":534,\"sha\":\"e0507dfeb4a1bb79142df54805d250dec9f92193\",\"commit_sha\":\"e95577363719900b497022c64d1e88dc95b5f0ef\",\"encoding\":\"utf-8\",\"content\":\"schema_version = \\\"1.1\\\"\\n\\n[task]\\nname = \\\"trivia-host/night1-sydney\\\"\\ndescription = \\\"A new venue's first night (The Lord Nelson, Sydney): the host plays six rounds to a simulated crowd and leaves its notes in memories/MEMORY.md\\\"\\n\\n[metadata]\\ncase = \\\"C3\\\"\\nvenue = \\\"page-sydney\\\"\\n\\n[verifier]\\ntimeout_sec = 120.0\\n\\n[agent]\\ntimeout_sec = 900.0\\n\\n[environment]\\nbuild_timeout_sec = 600.0\\ncpus = 1\\nmemory_mb = 2048\\n\\n[environment.env]\\nANTHROPIC_API_KEY = \\\"${ANTHROPIC_API_KEY:-}\\\"\\n\\n[[artifacts]]\\nsource = \\\"/workspace/memories\\\"\\ndestination = \\\"memories\\\"\\n\",\"truncated\":false}"
