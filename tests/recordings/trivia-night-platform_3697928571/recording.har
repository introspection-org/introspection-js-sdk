            "text": "{\"records\":[{\"created_at\":\"2026-11-25T02:43:05.127007Z\",\"updated_at\":\"2026-11-25T02:43:05.266151Z\",\"org_id\":\"01a1f151-1db2-761f-a50b-e065db62b262\",\"project_id\":\"01a1f15d-4fb5-700d-841b-6fb6ff2a783d\",\"id\":\"01a21095-d71c-76a0-aeb2-79ee6351a80d\",\"title\":\"Evening! Five teams tonight here in Sydney: Quizzly Bears, Les Quizerables, The Bondi Brainstormers, Opera House Party and The Blow-Ins. Quizzly Bears, Les Quizerables, The Bondi Brainstormers and Opera House Party were here last week; The Blow-Ins is…\",\"display_index\":859,\"status\":\"scheduled\",\"kind\":\"eval\",\"member_id\":\"01a1f151-1db9-77ff-aea1-057ce964fab3\",\"routine_id\":null,\"runtime_group_id\":\"01a2049b-c96b-7539-9665-0821b741dcd1\",\"runtime_id\":\"01a20a7c-077e-7066-8429-59576969a693\",\"is_archived\":false,\"started_at\":null,\"completed_at\":null,\"last_user_message_at\":\"2026-11-25T02:43:05.135311Z\",\"metadata\":{\"error\":null,\"memory\":{\"remote_prefix\":\"memory/staging/anon:sim-r1795574584575-sydney-fresh/\"},\"compose\":{\"main\":{\"volumes\":[\"fakes-verifier:/opt/fakes-verifier:ro\",\"harbor-logs:/logs\",\"harbor-tests:/tests\"],\"depends_on\":{\"fakes\":{\"required\":true,\"condition\":\"service_healthy\"}}},\"volumes\":{\"harbor-logs\":null,\"harbor-tests\":null,\"fakes-verifier\":{}},\"services\":{\"fakes\":{\"image\":\"host.docker.internal:5001/sandbox-builds:image-7cdeff86a790009f4ed25dea000d6184dff26b56@sha256:1c44b765b546f28b702568fa58b1cfc9dd003d504e5d9288fe58ffbcdce784e4\",\"ports\":[],\"expose\":[],\"volumes\":[\"fakes-verifier:/verifier\"],\"environment\":{\"EVAL_SIMULATE_NIGHT\":\"2\",\"EVAL_SIMULATE_TEAMS\":\"5\",\"EVAL_SIMULATE_SCENARIO\":\"crowd-page-sydney\",\"EVAL_SIMULATE_MANIFEST_DIR\":\"/verifier\",\"EVAL_SIMULATE_SERIES_NIGHTS\":\"2\"},\"healthcheck\":{\"test\":[\"CMD\",\"node\",\"-e\",\"fetch('http://127.0.0.1:7353/health').then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))\"],\"disable\":false,\"retries\":30,\"tim