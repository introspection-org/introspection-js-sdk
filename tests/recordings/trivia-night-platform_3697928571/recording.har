\"-e\",\"fetch('http://127.0.0.1:7353/health').then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))\"],\"disable\":false,\"retries\":30,\"timeout\":\"30s\",\"interval\":\"1s\",\"start_period\":\"0s\"}}}},\"commands\":true,\"identity\":{\"tags\":[\"simulation:r3577419069331577\",\"simulation:trivia-night\"],\"anonymous_id\":\"sim-r3577419069331577-sydney-fresh\"},\"verifier\":{\"command\":[\"sh\",\"/tests/test.sh\"],\"tests_path\":\"evals/harbor/night2-sydney/tests\",\"reward_path\":\"/logs/verifier/reward.json\",\"timeout_seconds\":120},\"task_path\":\"evals/harbor/night2-sydney\",\"task_prompt\":\"Evening! Five teams tonight here in Sydney: Quizzly Bears, Les Quizerables, The Bondi Brainstormers, Opera House Party and The Blow-Ins. Quizzly Bears, Les Quizerables, The Bondi Brainstormers and Opera House Party were here last week; The Blow-Ins is new. Six short rounds of four again tonight: plan them, fetch each round and read it out. The bank records the crowd's answers as you serve each round, so you won't get a sheet back: after each round, check round_summary to see how they did. I won't reply until the night is over, so run all six rounds straight through in this one go without waiting for me. After the sixth round we're done, so leave your notes ready for next week.\\n\",\"trivia_night\":{\"step\":\"sydney/night2-fresh\",\"record\":{\"run\":\"r3577419069331577\",\"pubs\":\"development\",\"teams\":5,\"target\":{\"commit\":\"2a6d7605904912a1e7d38d414484df631648c92f\",\"runtime\":\"01a20a7c-077e-7066-8429-59576969a693\",\"repository\":\"9e02cb78-24f4-57f0-8725-568e0dfff815\",\"recipe_path\":\"\"},\"venues\":1,\"started_at\":\"2026-11-25T05:19:48.323Z\",\"started_by\":\"recorded-member\"}},\"active_run_id\":\"01a21125-5401-77b3-8f64-eada3998d824\",\"admission_key\":\"2a411db4-df8d-50a0-b075-a4c304d79be0\",\"invocation_id\":\"inv_1fLmIQcpWzt71byx0RAnRfNs3571qeK0ry\",\"latest_run_id\":\"01a21125-5401-77b3-8f64-eada3998d824\",\"crash_restarts\":null,\"history_recall\