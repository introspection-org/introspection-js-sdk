            "text": "{\"type\":\"file\",\"name\":\"task.toml\",\"path\":\"evals/harbor/night1-sydney/task.toml\",\"size\":534,\"sha\":\"e0507dfeb4a1bb79142df54805d250dec9f92193\",\"commit_sha\":\"393c952f976e52419f415a60b4f6c6944776eb2b\",\"encoding\":\"utf-8\",\"content\":\"schema_version = \\\"1.1\\\"\\n\\n[task]\\nname = \\\"trivia-host/night1-sydney\\\"\\ndescription = \\\"A new venue's first night (The Lord Nelson, Sydney): the host plays six rounds to a simulated crowd and leaves its notes in memories/MEMORY.md\\\"\\n\\n[metadata]\\ncase = \\\"C3\\\"\\nvenue = \\\"page-sydney\\\"\\n\\n[verifier]\\ntimeout_sec = 120.0\\n\\n[agent]\\ntimeout_sec = 900.0\\n\\n[environment]\\nbuild_timeout_sec = 600.0\\ncpus = 1\\nmemory_mb = 2048\\n\\n[environment.env]\\nANTHROPIC_API_KEY = \\\"${ANTHROPIC_API_KEY:-}\\\"\\n\\n[[artifacts]]\\nsource = \\\"/workspace/memories\\\"\\ndestination = \\\"memories\\\"\\n\",\"truncated\":false}"
