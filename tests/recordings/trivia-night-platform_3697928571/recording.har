             \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": false\n            }\n          ]\n        },\n        {\n          \"text\": \"Which British director made Age of Consent (1969), shot on Queensland's Dunk Island with James Mason and a young Helen Mirren?\",\n          \"options\": [\n            \"Carol Reed\",\n            \"David Lean\",\n            \"Michael Powell\",\n            \"Ken Russell\"\n          ],\n          \"answer\": \"Michael Powell\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        },\n        {\n          \"text\": \"In 'Skippy the Bush Kangaroo', what is the first name of the park ranger's young son who befriends Skippy?\",\n          \"answer\": \"Sonny\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"round\": 4,\n      \"genre\": \"sport\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.65,\n      \"questions\": [\n        {\n          \"text\": \"Which Australian won the 1980 Formula One World Championship driving for Williams?\",\n          \"answer\": \"Alan Jones\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": false\n            }\n          ]\n        },\n        {\n          \"text\": \"In 1976, who won the Australian Open men's singles as a lowly ranked outsider?\",\n          \"options\": [\n            \"Paul McNamee\",\n            \"Mark Edmondson\",\n            \"John Alexander\",\n            \"Phil Dent\"\n          ],\n          \"answer\": \"Mark Edmondson\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        },\n        {\n          \"text\": \"Which Australian city hosted the 1982 Commonwealth Games?\",\n          \"options\": [\n            \"Brisbane\",\n            \"Adelaide\",\n            \"Melbourne\",\n            \"Perth\"\n          ],\n          \"answer\": \"Brisbane\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": false\n            }\n          ]\n        },\n        {\n          \"text\": \"Which AFL club won three straight premierships from 2013 to 2015?\",\n          \"answer\": \"Hawthorn\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"round\": 5,\n      \"genre\": \"film\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.9,\n      \"questions\": [\n        {\n          \"text\": \"In Jocelyn Moorhouse's Proof (1991), Hugo Weaving plays a blind man with what unusual hobby?\",\n          \"answer\": \"Photography\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": false\n            }\n          ]\n        },\n        {\n          \"text\": \"In 'Colin from Accounts' (2022), what kind of animal is Colin?\",\n          \"answer\": \"Dog\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        },\n        {\n          \"text\": \"In which Australian city was Mortal Kombat (2021) filmed?\",\n          \"options\": [\n            \"Darwin\",\n            \"Perth\",\n            \"Adelaide\",\n            \"Hobart\"\n          ],\n          \"answer\": \"Adelaide\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        },\n        {\n          \"text\": \"In the 1977 Australian animated film 'Dot and the Kangaroo', a lost girl is given magic berries by a kangaroo. What do the berries let her do?\",\n          \"options\": [\n            \"Shrink to insect size\",\n            \"Fly over the bush\",\n            \"Become invisible\",\n            \"Understand the animals\"\n          ],\n          \"answer\": \"Understand the animals\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"round\": 6,\n      \"genre\": \"history\",\n      \"difficulty\": 3,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.4,\n      \"questions\": [\n        {\n          \"text\": \"Which Canberra institution, opened in 1970s debate, saw Whitlam buy Jackson Pollock's 'Blue Poles' in 1973?\",\n          \"options\": [\n            \"National Museum\",\n            \"National Library\",\n            \"Australian War Memorial\",\n            \"National Gallery of Australia\"\n          ],\n          \"answer\": \"National Gallery of Australia\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        },\n        {\n          \"text\": \"Which national health insurance scheme did the Whitlam government introduce in 1975?\",\n          \"options\": [\n            \"Medicare\",\n            \"Medisafe\",\n            \"Healthcover\",\n            \"Medibank\"\n          ],\n          \"answer\": \"Medibank\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": false\n            }\n          ]\n        },\n        {\n          \"text\": \"Western Australia kept its border closed during COVID; in which year did it finally reopen?\",\n          \"options\": [\n            \"2023\",\n            \"2021\",\n            \"2020\",\n            \"2022\"\n          ],\n          \"answer\": \"2022\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": false\n            }\n          ]\n        },\n        {\n          \"text\": \"Which 1997 report into the Stolen Generations had a title beginning 'Bringing Them...'?\",\n          \"answer\": \"Bringing Them Home\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        }\n      ]\n    }\n  ],\n  \"notes\": \"# Venue notes (Sydney, Australia)\\n\\n- Country/region: Australia, use region `au` (plus global if needed).\\n- Format used in week 1: 6 rounds of 4 questions (trivia master's choice that night; default is 5 x 8). The bank records answers as each round is served, so check round_summary after each round.\\n- Genres: crowd loves film (the trivia master says so; film scored best, ~70-77%). Music (45%) and history (40%) were hard at level 3. Sport was fine at level 2 (65%). Science and geography not yet tried: give them a turn next week.\\n- Difficulty: level 3 was too hard overall (~50-55% right); level 2 was slightly easy (~77%). Start next night at 2 and step up to 3 only if the room is over 75%. Film at 3 was OK (65%), so film can start a notch higher than other genres.\\n\"\n}\n"
          },
