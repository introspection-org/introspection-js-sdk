          "headersSize": 202,
          "httpVersion": "HTTP/1.1",
          "method": "POST",
          "postData": {
            "mimeType": "application/json",
            "params": [],
            "text": "{\"prompt\":\"Evening! Five teams tonight here in Sydney: Quizzly Bears, Les Quizerables, The Bondi Brainstormers, Opera House Party and The Blow-Ins. Quizzly Bears, Les Quizerables, The Bondi Brainstormers and Opera House Party were here last week; The Blow-Ins is new. Six short rounds of four again tonight: plan them, fetch each round and read it out. The bank records the crowd's answers as you serve each round, so you won't get a sheet back: after each round, check round_summary to see how they did. I won't reply until the night is over, so run all six rounds straight through in this one go without waiting for me. After the sixth round we're done, so leave your notes ready for next week.\",\"kind\":\"eval\",\"runtime_id\":\"01a20a7c-077e-7066-8429-59576969a693\",\"recipe_git_commit_sha\":\"e95577363719900b497022c64d1e88dc95b5f0ef\",\"commands\":true,\"idle_timeout_seconds\":3600,\"tags\":[\"simulation:r1707866600018765\",\"simulation:trivia-night\"],\"compose\":{\"services\":{\"main\":{\"depends_on\":{\"fakes\":{\"condition\":\"service_healthy\"}},\"volumes\":[\"fakes-verifier:/opt/fakes-verifier:ro\",\"harbor-logs:/logs\",\"harbor-tests:/tests\"]},\"fakes\":{\"environment\":{\"EVAL_SIMULATE_SCENARIO\":\"crowd-page-sydney\",\"EVAL_SIMULATE_NIGHT\":\"2\",\"EVAL_SIMULATE_SERIES_NIGHTS\":\"2\",\"EVAL_SIMULATE_TEAMS\":\"5\",\"EVAL_SIMULATE_MANIFEST_DIR\":\"/verifier\"},\"volumes\":[\"fakes-verifier:/verifier\"],\"healthcheck\":{\"test\":[\"CMD\",\"node\",\"-e\",\"fetch('http://127.0.0.1:7353/health').then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))\"],\"interval\":\"1s\",\"retries\":30},\"image\":\"host.docker.internal:5001/sandbox-builds:image-7cdeff86a790009f4ed25dea000d6184dff26b56@sha256:1c44b765b546f28b702568fa58b1cfc9dd003d504e5d9288fe58ffbcdce784e4\"}},\"volumes\":{\"fakes-verifier\":{},\"harbor-logs\":null,\"harbor-tests\":null}},\"verifier\":{\"tests_file_id\":\"01a210b6-e0f5-77d1-b861-f13be368d0f0\",\"command\":[\"sh\",\"/tests/tes