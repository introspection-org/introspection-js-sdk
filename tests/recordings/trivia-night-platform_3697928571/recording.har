\":\"5\",\"EVAL_SIMULATE_SCENARIO\":\"crowd-page-sydney\",\"EVAL_SIMULATE_MANIFEST_DIR\":\"/verifier\",\"EVAL_SIMULATE_SERIES_NIGHTS\":\"2\"},\"healthcheck\":{\"test\":[\"CMD\",\"node\",\"-e\",\"fetch('http://127.0.0.1:7353/health').then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))\"],\"disable\":false,\"retries\":30,\"timeout\":\"30s\",\"interval\":\"1s\",\"start_period\":\"0s\"}}}},\"commands\":true,\"identity\":{\"tags\":[\"simulation:r2078647241476559\",\"simulation:trivia-night\"],\"anonymous_id\":\"sim-r2078647241476559-sydney-fresh\"},\"verifier\":{\"command\":[\"sh\",\"/tests/test.sh\"],\"reward_path\":\"/logs/verifier/result.json\",\"tests_file_id\":\"01a210d0-d6ee-767d-aafd-68806f3c8e7b\",\"timeout_seconds\":120},\"task_prompt\":\"Evening! Five teams tonight here in Sydney: Quizzly Bears, Les Quizerables, The Bondi Brainstormers, Opera House Party and The Blow-Ins. Quizzly Bears, Les Quizerables, The Bondi Brainstormers and Opera House Party were here last week; The Blow-Ins is new. Six short rounds of four again tonight: plan them, fetch each round and read it out. The bank records the crowd's answers as you serve each round, so you won't get a sheet back: after each round, check round_summary to see how they did. I won't reply until the night is over, so run all six rounds straight through in this one go without waiting for me. After the sixth round we're done, so leave your notes ready for next week.\",\"trivia_night\":{\"step\":\"sydney/night2-fresh\",\"record\":{\"run\":\"r2078647241476559\",\"pubs\":\"development\",\"teams\":5,\"target\":{\"slug\":\"trivia-host\",\"commit\":\"e95577363719900b497022c64d1e88dc95b5f0ef\",\"runtime\":\"01a20a7c-077e-7066-8429-59576969a693\",\"repository\":\"9e02cb78-24f4-57f0-8725-568e0dfff815\",\"recipe_path\":\"\"},\"venues\":1,\"started_at\":\"2026-11-25T03:47:30.419Z\",\"started_by\":\"recorded-member\"}},\"active_run_id\":\"01a210d0-d6f9-71e3-a28a-d8892420ca89\",\"admission_key\":\"a5abaf81-02ee-5d07-bf97-80b2e8