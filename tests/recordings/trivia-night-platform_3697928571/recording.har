            "size": 24835,
            "text": "{\n  \"reward\": 1,\n  \"fetched_a_round\": 1,\n  \"notes_kept\": 1,\n  \"notes_indexed\": 1,\n  \"pitch_miss\": 0.07,\n  \"in_band\": 1,\n  \"close_finish\": 0.08,\n  \"bottom_share\": 0.68,\n  \"lead_changes_count\": 0,\n  \"lead_changes\": 0,\n  \"good_rounds\": 0.33,\n  \"favourite_genre\": 0.33,\n  \"right_region\": 1,\n  \"first_round_in_band\": 1,\n  \"rounds_played\": 6,\n  \"round_rates\": [\n    0.55,\n    0.75,\n    0.65,\n    0.6,\n    0.75,\n    0.6\n  ],\n  \"liked\": [\n    \"film\",\n    \"music\"\n  ],\n  \"fetches\": [\n    {\n      \"round\": 1,\n      \"genre\": \"music\",\n      \"difficulty\": 3,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.55\n    },\n    {\n      \"round\": 2,\n      \"genre\": \"film\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.75\n    },\n    {\n      \"round\": 3,\n      \"genre\": \"sport\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.65\n    },\n    {\n      \"round\": 4,\n      \"genre\": \"science\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.6\n    },\n    {\n      \"round\": 5,\n      \"genre\": \"history\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.75\n    },\n    {\n      \"round\": 6,\n      \"genre\": \"geography\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.6\n    }\n  ],\n  \"rounds\": [\n    {\n      \"round\": 1,\n      \"genre\": \"music\",\n      \"difficulty\": 3,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.55,\n      \"questions\": [\n        {\n          \"text\": \"Which singer-songwriter wrote 'I Still Call Australia Home', famously used in Qantas advertising?\",\n          \"options\": [\n            \"John Farnham\",\n            \"Paul Kelly\",\n            \"Peter Allen\",\n            \"Glenn Shorrock\"\n          ],\n          \"answer\": \"Peter Allen\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"The Blow-Ins\",\n              \"answer\": \"\",\n              \"correct\": false\n            }\n          ]\n        },\n        {\n          \"text\": \"Which Yorta Yorta singer had a 1963 hit with the gospel song 'Royal Telephone'?\",\n          \"options\": [\n            \"Kev Carmody\",\n            \"Lionel Rose\",\n            \"Archie Roach\",\n            \"Jimmy Little\"\n          ],\n          \"answer\": \"Jimmy Little\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"The Blow-Ins\",\n              \"answer\": \"\",\n              \"correct\": false\n            }\n          ]\n        },\n        {\n          \"text\": \"What is the name of the record label Courtney Barnett founded, sharing its name with a dairy drink?\",\n          \"answer\": \"Milk! Records\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Blow-Ins\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        },\n        {\n          \"text\": \"Which Australian folk band, led by John Schumann, released the 1983 Vietnam veterans' anthem 'I Was Only 19'?\",\n          \"answer\": \"Redgum\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Blow-Ins\",\n              \"answer\": \"\",\n              \"correct\": false\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"round\": 2,\n      \"genre\": \"film\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.75,\n      \"questions\": [\n        {\n          \"text\": \"Geoffrey Rush won an Oscar playing pianist David Helfgott in which 1996 film?\",\n          \"answer\": \"Shine\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"The Blow-Ins\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        },\n        {\n          \"text\": \"In 'Crocodile Dundee', what is Mick Dundee's first name in full?\",\n          \"answer\": \"Michael\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"The Blow-Ins\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        },\n        {\n          \"text\": \"In 'Oddball' (2015), a Maremma dog guards which b