            "text": "{\"type\":\"file\",\"name\":\"docker-compose.yaml\",\"path\":\"evals/harbor/night1-sydney/environment/docker-compose.yaml\",\"size\":722,\"sha\":\"26dc8576baa1693e15b438c00cbb53146e51126e\",\"commit_sha\":\"e95577363719900b497022c64d1e88dc95b5f0ef\",\"encoding\":\"utf-8\",\"content\":\"services:\\n  main:\\n    depends_on:\\n      fakes:\\n        condition: service_healthy\\n    volumes:\\n      - fakes-verifier:/opt/fakes-verifier:ro\\n  fakes:\\n    build:\\n      context: ../../../../fakes\\n    environment:\\n      EVAL_SIMULATE_SCENARIO: crowd-page-sydney\\n      EVAL_SIMULATE_NIGHT: \\\"1\\\"\\n      EVAL_SIMULATE_SERIES_NIGHTS: \\\"2\\\"\\n      EVAL_SIMULATE_TEAMS: \\\"5\\\"\\n      EVAL_SIMULATE_MANIFEST_DIR: /verifier\\n    volumes:\\n      - fakes-verifier:/verifier\\n    healthcheck:\\n      test:\\n        [\\n          \\\"CMD\\\",\\n          \\\"node\\\",\\n          \\\"-e\\\",\\n          \\\"fetch('http://127.0.0.1:7353/health').then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))\\\",\\n        ]\\n      interval: 1s\\n      retries: 30\\nvolumes:\\n  fakes-verifier: {}\\n\",\"truncated\":false}"
