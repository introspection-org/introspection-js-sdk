          "headersSize": 202,
          "httpVersion": "HTTP/1.1",
          "method": "POST",
          "postData": {
            "mimeType": "application/json",
            "params": [],
            "text": "{\"prompt\":\"Before next week's night here in Sydney, the trivia master has written up notes on the venue for you to keep. There's no quiz tonight, so don't start a night or fetch any questions: just replace memories/MEMORY.md with exactly the notes between the lines below, word for word, and nothing else.\\n\\n---\\n\\n# Venue notes\\n\\n- Country: Australia (Sydney). Use region `au` (or `global`).\\n- Genres: the crowd loves film and music. Plan about 4 of 6 rounds on those and keep the other genres in rotation.\\n- They don't enjoy science: keep it rare.\\n- Difficulty: start next night at 2. Aim for about two in three right and adjust from round_summary.\\n- Eras: the crowd knows the 2010s and 2000s best.\\n\\n---\",\"kind\":\"eval\",\"runtime_id\":\"01a20a7c-077e-7066-8429-59576969a693\",\"recipe_git_commit_sha\":\"393c952f976e52419f415a60b4f6c6944776eb2b\",\"commands\":true,\"idle_timeout_seconds\":3600,\"tags\":[\"simulation:r1795572868330\",\"simulation:trivia-night\"],\"compose\":{\"services\":{\"main\":{\"depends_on\":{\"fakes\":{\"condition\":\"service_healthy\"}},\"volumes\":[\"fakes-verifier:/opt/fakes-verifier:ro\",\"harbor-logs:/logs\",\"harbor-tests:/tests\"]},\"fakes\":{\"environment\":{\"EVAL_SIMULATE_SCENARIO\":\"crowd-page-sydney\",\"EVAL_SIMULATE_NIGHT\":\"1\",\"EVAL_SIMULATE_SERIES_NIGHTS\":\"2\",\"EVAL_SIMULATE_TEAMS\":\"5\",\"EVAL_SIMULATE_MANIFEST_DIR\":\"/verifier\"},\"volumes\":[\"fakes-verifier:/verifier\"],\"healthcheck\":{\"test\":[\"CMD\",\"node\",\"-e\",\"fetch('http://127.0.0.1:7353/health').then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))\"],\"interval\":\"1s\",\"retries\":30},\"image\":\"host.docker.internal:5001/sandbox-builds:image-7cdeff86a790009f4ed25dea000d6184dff26b56@sha256:1c44b765b546f28b702568fa58b1cfc9dd003d504e5d9288fe58ffbcdce784e4\"}},\"volumes\":{\"fakes-verifier\":{},\"harbor-logs\":null,\"harbor-tests\":null}},\"verifier\":{\"tests_file_id\":\"01a2107b-a774-767d-9fc9-1058adee13dc\",\"comm