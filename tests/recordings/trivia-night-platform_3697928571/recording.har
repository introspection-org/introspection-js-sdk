            "text": "{\"type\":\"file\",\"name\":\"task.toml\",\"path\":\"evals/harbor/night0-sydney/task.toml\",\"size\":517,\"sha\":\"b77d02f6234e628a4b4f83463fa8adcc52c8510d\",\"commit_sha\":\"e95577363719900b497022c64d1e88dc95b5f0ef\",\"encoding\":\"utf-8\",\"content\":\"schema_version = \\\"1.1\\\"\\n\\n[task]\\nname = \\\"trivia-host/night0-sydney\\\"\\ndescription = \\\"Seeds the venue's true notes (The Lord Nelson, Sydney) in memories/MEMORY.md for the perfect-notes night 2; no quiz is played\\\"\\n\\n[metadata]\\ncase = \\\"C3\\\"\\nvenue = \\\"page-sydney\\\"\\n\\n[verifier]\\ntimeout_sec = 120.0\\n\\n[agent]\\ntimeout_sec = 900.0\\n\\n[environment]\\nbuild_timeout_sec = 600.0\\ncpus = 1\\nmemory_mb = 2048\\n\\n[environment.env]\\nANTHROPIC_API_KEY = \\\"${ANTHROPIC_API_KEY:-}\\\"\\n\\n[[artifacts]]\\nsource = \\\"/workspace/memories\\\"\\ndestination = \\\"memories\\\"\\n\",\"truncated\":false}"
