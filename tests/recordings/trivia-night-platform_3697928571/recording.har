n Open men's singles as a lowly ranked outsider?\",\n          \"options\": [\n            \"Paul McNamee\",\n            \"Mark Edmondson\",\n            \"John Alexander\",\n            \"Phil Dent\"\n          ],\n          \"answer\": \"Mark Edmondson\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        },\n        {\n          \"text\": \"Which Australian city hosted the 1982 Commonwealth Games?\",\n          \"options\": [\n            \"Brisbane\",\n            \"Adelaide\",\n            \"Melbourne\",\n            \"Perth\"\n          ],\n          \"answer\": \"Brisbane\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"