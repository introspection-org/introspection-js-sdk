            "text": "{\"type\":\"file\",\"name\":\"task.toml\",\"path\":\"evals/harbor/night2-sydney/task.toml\",\"size\":552,\"sha\":\"6d6037d9ea971d775eb54f01f27c836fa3813871\",\"commit_sha\":\"393c952f976e52419f415a60b4f6c6944776eb2b\",\"encoding\":\"utf-8\",\"content\":\"schema_version = \\\"1.1\\\"\\n\\n[task]\\nname = \\\"trivia-host/night2-sydney\\\"\\ndescription = \\\"The second night at The Lord Nelson, Sydney: six rounds to a simulated crowd, most of it night 1's teams, pitched from the identity's own memory or from nothing\\\"\\n\\n[metadata]\\ncase = \\\"C3\\\"\\nvenue = \\\"page-sydney\\\"\\n\\n[verifier]\\ntimeout_sec = 120.0\\n\\n[agent]\\ntimeout_sec = 900.0\\n\\n[environment]\\nbuild_timeout_sec = 600.0\\ncpus = 1\\nmemory_mb = 2048\\n\\n[environment.env]\\nANTHROPIC_API_KEY = \\\"${ANTHROPIC_API_KEY:-}\\\"\\n\\n[[artifacts]]\\nsource = \\\"/workspace/memories\\\"\\ndestination = \\\"memories\\\"\\n\",\"truncated\":false}"
