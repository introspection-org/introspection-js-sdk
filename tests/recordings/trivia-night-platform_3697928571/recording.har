          "headersSize": 202,
          "httpVersion": "HTTP/1.1",
          "method": "POST",
          "postData": {
            "mimeType": "application/json",
            "params": [],
            "text": "{\"prompt\":\"We're in Sydney, in Australia, and it's our first trivia night with you. Five teams tonight: Quizzly Bears, Les Quizerables, Trivia Newton-John, The Bondi Brainstormers and Opera House Party. From what I've seen, this crowd loves film. We've time for six short rounds of four questions: plan the night, fetch each round and read it out. The bank records the crowd's answers as you serve each round, so you won't get a sheet back: after each round, check round_summary to see how they did. I won't reply until the night is over, so run all six rounds straight through in this one go without waiting for me. After the sixth round that's the end of tonight: leave your notes ready for next week, as you would after the last round.\",\"kind\":\"eval\",\"runtime_id\":\"01a20a7c-077e-7066-8429-59576969a693\",\"recipe_git_commit_sha\":\"e95577363719900b497022c64d1e88dc95b5f0ef\",\"commands\":true,\"idle_timeout_seconds\":3600,\"tags\":[\"simulation:r1949663248619674\",\"simulation:trivia-night\"],\"compose\":{\"services\":{\"main\":{\"depends_on\":{\"fakes\":{\"condition\":\"service_healthy\"}},\"volumes\":[\"fakes-verifier:/opt/fakes-verifier:ro\",\"harbor-logs:/logs\",\"harbor-tests:/tests\"]},\"fakes\":{\"environment\":{\"EVAL_SIMULATE_SCENARIO\":\"crowd-page-sydney\",\"EVAL_SIMULATE_NIGHT\":\"1\",\"EVAL_SIMULATE_SERIES_NIGHTS\":\"2\",\"EVAL_SIMULATE_TEAMS\":\"5\",\"EVAL_SIMULATE_MANIFEST_DIR\":\"/verifier\"},\"volumes\":[\"fakes-verifier:/verifier\"],\"healthcheck\":{\"test\":[\"CMD\",\"node\",\"-e\",\"fetch('http://127.0.0.1:7353/health').then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))\"],\"interval\":\"1s\",\"retries\":30},\"image\":\"host.docker.internal:5001/sandbox-builds:image-7cdeff86a790009f4ed25dea000d6184dff26b56@sha256:1c44b765b546f28b702568fa58b1cfc9dd003d504e5d9288fe58ffbcdce784e4\"}},\"volumes\":{\"fakes-verifier\":{},\"harbor-logs\":null,\"harbor-tests\":null}},\"verifier\":{\"tests_file_id\":\"01a210e0-5b4a-76c9-970e-2432dad86476\",\"command\":[\"sh\",\"/tests/test.sh\"],\"reward_path\":\"/logs/verifier/result.json\",\"timeout_seconds\":120},\"metadata\":{\"admission_key\":\"92728acc-c963-5a13-a777-1c864298b318\",\"identity\":{\"anonymous_id\":\"sim-r1949663248619674-sydney\",\"tags\":[\"simulation:r1949663248619674\",\"simulation:trivia-night\"]},\"trivia_night\":{\"step\":\"sydney/night1-memory\",\"record\":{\"run\":\"r1949663248619674\",\"venues\":1,\"teams\":5,\"pubs\":\"development\",\"started_by\":\"recorded-member\",\"started_at\":\"2026-11-25T04:04:27.295Z\",\"target\":{\"runtime\":\"01a20a7c-077e-7066-8429-59576969a693\",\"commit\":\"e95577363719900b497022c64d1e88dc95b5f0ef\",\"repository\":\"9e02cb78-24f4-57f0-8725-568e0dfff815\",\"recipe_path\":\"\"}}}}}"
