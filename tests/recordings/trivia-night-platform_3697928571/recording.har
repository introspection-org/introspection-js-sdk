            "mimeType": "application/octet-stream",
            "size": 24795,
            "text": "{\n  \"reward\": 1,\n  \"fetched_a_round\": 1,\n  \"notes_kept\": 1,\n  \"notes_indexed\": 1,\n  \"pitch_miss\": 0.1,\n  \"in_band\": 0.83,\n  \"close_finish\": 0.04,\n  \"bottom_share\": 0.79,\n  \"lead_changes_count\": 1,\n  \"lead_changes\": 0.2,\n  \"good_rounds\": 0.33,\n  \"favourite_genre\": 0.5,\n  \"right_region\": 1,\n  \"first_round_in_band\": 1,\n  \"rounds_played\": 6,\n  \"round_rates\": [\n    0.75,\n    0.75,\n    0.6,\n    0.8,\n    0.55,\n    0.75\n  ],\n  \"liked\": [\n    \"film\",\n    \"music\"\n  ],\n  \"fetches\": [\n    {\n      \"round\": 1,\n      \"genre\": \"film\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.75\n    },\n    {\n      \"round\": 2,\n      \"genre\": \"history\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.75\n    },\n    {\n      \"round\": 3,\n      \"genre\": \"geography\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.6\n    },\n    {\n      \"round\": 4,\n      \"genre\": \"film\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.8\n    },\n    {\n      \"round\": 5,\n      \"genre\": \"sport\",\n      \"difficulty\": 3,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.55\n    },\n    {\n      \"round\": 6,\n      \"genre\": \"film\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.75\n    }\n  ],\n  \"rounds\": [\n    {\n      \"round\": 1,\n      \"genre\": \"film\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.75,\n      \"questions\": [\n        {\n          \"text\": \"Geoffrey Rush won an Oscar playing pianist David Helfgott in which 1996 film?\",\n          \"answer\": \"Shine\",\n          \"marks\": [\n            {\n              \"team\"