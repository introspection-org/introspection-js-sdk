ULATE_NIGHT\":\"2\",\"EVAL_SIMULATE_TEAMS\":\"5\",\"EVAL_SIMULATE_SCENARIO\":\"crowd-page-sydney\",\"EVAL_SIMULATE_MANIFEST_DIR\":\"/verifier\",\"EVAL_SIMULATE_SERIES_NIGHTS\":\"2\"},\"healthcheck\":{\"test\":[\"CMD\",\"node\",\"-e\",\"fetch('http://127.0.0.1:7353/health').then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))\"],\"disable\":false,\"retries\":30,\"timeout\":\"30s\",\"interval\":\"1s\",\"start_period\":\"0s\"}}}},\"commands\":true,\"identity\":{\"tags\":[\"simulation:r1795572868330\",\"simulation:trivia-night\"],\"anonymous_id\":\"sim-r1795572868330-sydney-fresh\"},\"verifier\":{\"command\":[\"sh\",\"/tests/test.sh\"],\"reward_path\":\"/logs/verifier/reward.json\",\"tests_file_id\":\"01a2107b-a770-711d-8637-c2fccfe31c49\",\"timeout_seconds\":120},\"task_prompt\":\"Evening! Five teams tonight here in Sydney: Quizzly Bears, Les Quizerables, The Bondi Brainstormers, Opera House Party and The Blow-Ins. Quizzly Bears, Les Quizerables, The Bondi Brainstormers and Opera House Party were here last week; The Blow-Ins is new. Six short rounds of four again tonight: plan them, fetch each round and read it out. The bank records the crowd's answers as you serve each round, so you won't get a sheet back: after each round, check round_summary to see how they did. I won't reply until the night is over, so run all six rounds straight through in this one go without waiting for me. After the sixth round we're done, so leave your notes ready for next week.\",\"trivia_night\":{\"step\":\"sydney/night2-fresh\",\"record\":{\"run\":\"r1795572868330\",\"pubs\":\"development\",\"teams\":5,\"target\":{\"slug\":\"trivia-host\",\"commit\":\"393c952f976e52419f415a60b4f6c6944776eb2b\",\"runtime\":\"01a20a7c-077e-7066-8429-59576969a693\",\"repository\":\"9e02cb78-24f4-57f0-8725-568e0dfff815\",\"recipe_path\":\"\"},\"venues\":1,\"started_at\":\"2026-11-25T02:14:28.330Z\",\"started_by\":\"m-test\"}},\"active_run_id\":\"01a2107b-a77c-71f6-92e1-b42ad8cc819d\",\"admission_key\":\"d293987