            "mimeType": "application/octet-stream",
            "size": 25575,
            "text": "{\n  \"reward\": 1,\n  \"night_started\": 1,\n  \"round_fetched\": 1,\n  \"notes_written\": 1,\n  \"notes_name_no_team\": 1,\n  \"notes_indexed\": 1,\n  \"pitch_miss\": 0.13,\n  \"in_band\": 0.5,\n  \"close_finish\": 0,\n  \"bottom_share\": 0.61,\n  \"lead_changes_count\": 2,\n  \"lead_changes\": 0.4,\n  \"good_rounds\": 0.33,\n  \"favourite_genre\": 0.67,\n  \"right_region\": 1,\n  \"first_round_in_band\": 1,\n  \"rounds_played\": 6,\n  \"round_rates\": [\n    0.65,\n    0.45,\n    0.75,\n    0.65,\n    0.9,\n    0.4\n  ],\n  \"fetches\": [\n    {\n      \"round\": 1,\n      \"genre\": \"film\",\n      \"difficulty\": 3,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.65\n    },\n    {\n      \"round\": 2,\n      \"genre\": \"music\",\n      \"difficulty\": 3,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.45\n    },\n    {\n      \"round\": 3,\n      \"genre\": \"film\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.75\n    },\n    {\n      \"round\": 4,\n      \"genre\": \"sport\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.65\n    },\n    {\n      \"round\": 5,\n      \"genre\": \"film\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.9\n    },\n    {\n      \"round\": 6,\n      \"genre\": \"history\",\n      \"difficulty\": 3,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.4\n    }\n  ],\n  \"rounds\": [\n    {\n      \"round\": 1,\n      \"genre\": \"film\",\n      \"difficulty\": 3,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.65,\n      \"questions\": [\n        {\n          \"text\": \"Who directed the 1987 coming-of-age film 'The Year My Voice Broke', starring Noah Taylor and Ben Mendelsohn?\",\n          \"options\": [\n            \"John Duigan\",\n            \"Gillian Armstrong\",\n            \"Bruce Beresford\",\n            \"Phillip Noyce\"\n          ],\n          \"answer\": \"John Duigan\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": false\n            }\n          ]\n        },\n        {\n          \"text\": \"In the 2006 mockumentary 'Kenny', Shane Jacobson's hero works with what?\",\n          \"options\": [\n            \"Parking meters\",\n            \"Shopping trolleys\",\n            \"Portable toilets\",\n            \"Wedding cakes\"\n          ],\n          \"answer\": \"Portable toilets\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Trivia Newton-John\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            }