  \"correct\": true\n            },\n            {\n              \"team\": \"The Blow-Ins\",\n              \"answer\": \"\",\n              \"correct\": false\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"round\": 5,\n      \"genre\": \"music\",\n      \"difficulty\": 2,\n      \"region\": \"au\",\n      \"count\": 4,\n      \"correct_rate\": 0.85,\n      \"questions\": [\n        {\n          \"text\": \"Spiderbait's cover of Lead Belly's 'Black Betty' (2004) is sung by the band's drummer, known as what?\",\n          \"options\": [\n            \"Bubs\",\n            \"Whitey\",\n            \"Kram\",\n            \"Janet\"\n          ],\n          \"answer\": \"Kram\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Blow-Ins\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        },\n        {\n          \"text\": \"Which Tamworth music event is held each January?\",\n          \"answer\": \"Tamworth Country Music Festival\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Blow-Ins\",\n              \"answer\": \"\",\n              \"correct\": false\n            }\n          ]\n        },\n        {\n          \"text\": \"Skyhooks' 1975 album 'Living in the 70's' — which city's suburbs did their song 'Carlton (Lygon Street Limbo)' name-check?\",\n          \"answer\": \"Melbourne\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": false\n            },\n            {\n              \"team\": \"Opera House Party\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Blow-Ins\",\n              \"answer\": \"\",\n              \"correct\": true\n            }\n          ]\n        },\n        {\n          \"text\": \"Which instrument, a long wooden Aboriginal wind instrument, features on many Yothu Yindi recordings?\",\n          \"answer\": \"Didgeridoo\",\n          \"marks\": [\n            {\n              \"team\": \"Quizzly Bears\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"Les Quizerables\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n            {\n              \"team\": \"The Bondi Brainstormers\",\n              \"answer\": \"\",\n              \"correct\": true\n            },\n   