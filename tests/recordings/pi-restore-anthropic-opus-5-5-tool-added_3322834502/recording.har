            "text": "{\"model\":\"claude-opus-5-5\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"What is the weather in Tokyo? Use get_weather, then answer in one short sentence.\"}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01DmrmnjDYyTMeRAPtWTC5Qj\",\"name\":\"get_weather\",\"input\":{\"city\":\"Tokyo\"}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01DmrmnjDYyTMeRAPtWTC5Qj\",\"content\":\"Tokyo: clear\\n25°C, wind 10 km/h\",\"is_error\":false}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"The weather in Tokyo is clear and 25°C, with wind at 10 km/h.\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"What time is it in Tokyo? Use get_time, then answer briefly.\"}]},{\"role\":\"system\",\"content\":[{\"type\":\"tool_addition\",\"tool\":{\"type\":\"tool_definition\",\"definition\":{\"name\":\"get_time\",\"description\":\"Get the local time in a city.\",\"eager_input_streaming\":true,\"input_schema\":{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}},\"required\":[\"city\"]}}}}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01UosJwsD3pLX9BQ3fHrWCzu\",\"name\":\"get_time\",\"input\":{\"city\":\"Tokyo\"}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01UosJwsD3pLX9BQ3fHrWCzu\",\"content\":\"Tokyo: 09:00\",\"is_error\":false,\"cache_control\":{\"type\":\"ephemeral\"}}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}}],\"max_tokens\":128000,\"stream\":true,\"system\":[{\"type\":\"text\",\"text\":\"You are a weather assistant. Answer briefly.\\n\\n<addendum>\\nReference for pi-restore