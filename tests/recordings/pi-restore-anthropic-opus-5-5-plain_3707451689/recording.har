            "text": "{\"model\":\"claude-opus-5-5\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"What is the weather in Tokyo? Use get_weather, then answer in one short sentence.\"}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01Se2PzT4Lhrct5CDc6obP6d\",\"name\":\"get_weather\",\"input\":{\"city\":\"Tokyo\"}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01Se2PzT4Lhrct5CDc6obP6d\",\"content\":\"Tokyo: clear\\n25°C, wind 10 km/h\",\"is_error\":false}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"It's clear in Tokyo right now, 25°C with a 10 km/h wind.\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Is that warm? One word.\"}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"Thinking about whether 25°C counts as warm, and settling on a single word for it.\\n\\n\",\"signature\":\"\"},{\"type\":\"text\",\"text\":\"Yes.\"}]},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Should I bring an umbrella? One word.\",\"cache_control\":{\"type\":\"ephemeral\"}}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"medium\"}}],\"max_tokens\":128000,\"stream\":true,\"system\":[{\"type\":\"text\",\"text\":\"You are a weather assistant. Answer briefly.\\n\\n<addendum>\\nReference for pi-restore-anthropic-opus-5-5-plain: the weather desk's station catalog. Use it only when asked.\\n- Station 1: code WX001, elevation 0 m, reports hourly.\\n- Station 2: code WX002, elevation 37 m, reports hourly.\\n- Station 3: code WX003, elevation 74 m, reports hourly.\\n- Station 4: code WX004, elevation 111 m, reports hourly.\\n- Station 5: code WX005, elevation 148 m,