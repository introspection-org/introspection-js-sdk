ARKER\\\"}}]}>>\",\"active_run_id\":\"01a16a37-9fcd-7621-9070-3b972332b13b\",\"latest_run_id\":\"01a16a37-9fcd-7621-9070-3b972332b13b\",\"crash_restarts\":null,\"history_recall\":null,\"conversation_id\":\"01a16a37-9fcd-7621-9070-3b98b2b40668\",\"last_activity_at\":null,\"spawn_resolution\":{\"contract\":{\"kind\":\"pinned_git\",\"agent_name\":\"scripted\",\"recipe_sha\":\"543b8db50a839029b03d7ca7957884d806df646c\",\"recipe_repo\":\"6af38c13-9a59-5a41-936b-d4cae48ddf20\"},\"runtime_id\":\"01a16a37-0e80-76d1-b9e5-f65ff560c90e\",\"attribution_env\":{\"OTEL_SERVICE_NAME\":\"hello-mcp\",\"INTROSPECTION_RECIPE_ID\":\"01a16a37-0909-73eb-8e6c-e28ba4f08584\",\"INTROSPECTION_RECIPE_REF\":\"main\",\"INTROSPECTION_RUNTIME_ID\":\"01a16a37-0e80-76d1-b9e5-f65ff560c90e\",\"INTROSPECTION_ENVIRONMENT\":\"production\",\"INTROSPECTION_RECIPE_KIND\":\"production\",\"INTROSPECTION_RUNTIME_KIND\":\"byor\",\"INTROSPECTION_RUNTIME_NAME\":\"hello-mcp\",\"INTROSPECTION_RUNTIME_GROUP_ID\":\"01a16a36-fa98-750b-aed5-3cb7ec221c66\",\"INTROSPECTION_JUDGES_OPERATIONAL\":\"{\\\"greeting\\\":{\\\"enabled\\\":true,\\\"sample_rate\\\":1.0,\\\"judge_id\\\":\\\"01a16a36-fd96-77a5-a362-72343ad794cf\\\",\\\"definition_hash\\\":\\\"459455f76567d23931987f6e51b8709f8aca44f9c8f665a4d861297113406ba9\\\"}}\"},\"image_reference\":null,\"recipe_sub_path\":\"\",\"recipe_resources\":null,\"runtime_group_id\":\"01a16a36-fa98-750b-aed5-3cb7ec221c66\"},\"completion_reason\":null,\"runtime_environment\":\"production\",\"idle_timeout_seconds\":180},\"conversation_metadata\":{\"suite\":\"walk\",\"persona\":\"avery\"},\"tags\":[\"group:platform\",\"suite:walk\"],\"agent\":{\"sandbox_status\":\"provisioning\",\"session_id\":null}},\"run\":{\"id\":\"01a16a37-9fcd-7621-9070-3b972332b13b\",\"task_id\":\"01a16a37-9fcd-7621-9070-3b98b2b40668\",\"status\":\"pending\",\"created_at\":\"2026-10-23T19:23:12.720055Z\",\"updated_at\":\"2026-10-23T19:23:12.720055Z\",\"error\":null,\"completion_reason\":null}}"
