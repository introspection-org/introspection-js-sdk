          "url": "https://example-server.modelcontextprotocol.io/authorize?response_type=code&client_id=7ee0fa59-1d21-473b-b8e9-18d9b454d40a&redirect_uri=https%3A%2F%2Fapi.development.introspection.dev%2Fv1%2Foauth%2Fconnections%2Fcallback&scope=&state=O49LbPI4POiTMotpSRKeNeD6aVXrF-Wndi1qgDbP08s&code_challenge=jEgeyYcPdqpt4b5PgY_s8vnGtgwcrlo7ZDXbCBydIko&code_challenge_method=S256&resource=https%3A%2F%2Fexample-server.modelcontextprotocol.io%2F"
