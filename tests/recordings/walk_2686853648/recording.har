            "text": "{\"created_at\":\"2026-10-23T08:41:10.961720Z\",\"updated_at\":\"2026-10-23T08:41:10.961720Z\",\"org_id\":\"01a13d6d-f05f-7115-9cc9-4b168ba5d22d\",\"id\":\"01a167eb-d431-76c0-80fc-aafff4b34629\",\"name\":\"hello-mcp\",\"description\":null,\"kind\":\"byor\",\"llm_mode\":\"managed\",\"config_json\":{},\"project_id\":\"01a167eb-ca5a-7314-9cd9-1be2fc1d5ede\",\"recipe_id\":\"01a167eb-ccfc-7751-bba2-8d22d5f24c9a\",\"runtime_group_id\":\"01a167eb-d431-76c0-80fc-ab007a9f8f8b\",\"slug\":\"hello-mcp\",\"recipe_kind\":\"production\",\"recipe_ref\":\"main\",\"environments\":[\"staging\",\"production\"],\"image_build_status\":\"pending\",\"image_build_error_message\":null,\"image_build_metadata\":{},\"created_by_member_id\":\"01a13d6d-f063-76d5-b2f0-4fe69e032667\",\"yanked_at\":null,\"yanked_reason\":null,\"environment_ref\":null}"
