ut is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\",\"parameters\":{\"properties\":{\"command\":{\"description\":\"Shell command to execute\",\"type\":\"string\"},\"timeout\":{\"description\":\"Timeout in seconds (optional, no default timeout)\",\"type\":\"number\"}},\"required\":[\"command\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"write\",\"description\":\"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.\",\"parameters\":{\"properties\":{\"content\":{\"description\":\"Content to write to the file\",\"type\":\"string\"},\"path\":{\"description\":\"Path to the file to write (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\",\"content\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"mcp_hello-mcp_echo_921a5a7771\",\"description\":\"Echoes back the input\",\"parameters\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"message\":{\"description\":\"Message to echo\",\"type\":\"string\"}},\"required\":[\"message\"],\"type\":\"object\"},\"type\":\"function\"}]},\"input\":{\"messages\":[{\"role\":\"tool\",\"parts\":[{\"type\":\"tool_call_response\",\"id\":\"call_12196cf05acc4f9aa07a5ed8\",\"name\":\"bash\",\"response\":\"walk-marker-7f3a\"}],\"name\":\"bash\"}]},\"output\":{\"messages\":[{\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"content\":\"Echoed the message through hello-mcp and wrote it to the outputs file.\"}],\"finish_reason\":\"stop\",\"provider\":\"introspection\",\"model\":\"scripted-llm\",\"api\":\"openai-completions\",\"response_id\":\"chatcmpl-39cc2f02c7074a8fb7681f4df626e718\"}]},\"system_instructions\":[{\"type\":\"text\",\"content\":\"Use the declared hello MCP whenever the task asks you to echo a message.\\n## Managed workspace\\n\\n<workspace>\\n  <in