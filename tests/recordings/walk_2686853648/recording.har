            "text": "{\"sha\":\"4ba23a7e00c4b332f72ecdbdffd2a8294a0e23c7\",\"parents\":[],\"message\":\"walk: hello-mcp-6af253eb-f07b\",\"author\":{\"name\":\"SDK walk\",\"email\":\"walk@example.com\",\"date\":\"2026-11-09T23:14:55Z\"},\"committer\":{\"name\":\"SDK walk\",\"email\":null,\"date\":\"2026-11-09T23:14:55Z\"},\"files\":[{\"filename\":\".githooks/pre-commit\",\"status\":\"added\",\"additions\":4,\"deletions\":0,\"changes\":4},{\"filename\":\".github/workflows/recipe-validation.yml\",\"status\":\"added\",\"additions\":17,\"deletions\":0,\"changes\":17},{\"filename\":\".gitignore\",\"status\":\"added\",\"additions\":20,\"deletions\":0,\"changes\":20},{\"filename\":\".introspection/hello-mcp-6af253eb-f07b.yaml\",\"status\":\"added\",\"additions\":10,\"deletions\":0,\"changes\":10},{\"filename\":\".pi/mcp.local.example.json\",\"status\":\"added\",\"additions\":9,\"deletions\":0,\"changes\":9},{\"filename\":\".pi/mcp.remote.example.json\",\"status\":\"added\",\"additions\":12,\"deletions\":0,\"changes\":12},{\"filename\":\".recipeignore\",\"status\":\"added\",\"additions\":3,\"deletions\":0,\"changes\":3},{\"filename\":\"README.md\",\"status\":\"added\",\"additions\":282,\"deletions\":0,\"changes\":282},{\"filename\":\"agents/agent.yaml\",\"status\":\"added\",\"additions\":21,\"deletions\":0,\"changes\":21},{\"filename\":\"agents/scripted.yaml\",\"status\":\"added\",\"additions\":25,\"deletions\":0,\"changes\":25},{\"filename\":\"docs/mcp-bindings.md\",\"status\":\"added\",\"additions\":77,\"deletions\":0,\"changes\":77},{\"filename\":\"evals/cases/hello-mcp.md\",\"status\":\"added\",\"additions\":34,\"deletions\":0,\"changes\":34},{\"filename\":\"evals/harbor/hello-mcp/environment/docker-compose.yaml\",\"status\":\"added\",\"additions\":38,\"deletions\":0,\"changes\":38},{\"filename\":\"evals/harbor/hello-mcp/environment/mcp-server/Dockerfile\",\"status\":\"added\",\"additions\":13,\"deletions\":0,\"changes\":13},{\"filename\":\"evals/harbor/hello-mcp/environment/mcp-server/server.py\",\"status\":\"added\",\"additions\":35,\"deletions\":0,\"changes\":35},{\"filename\":\"evals/harbor/hello-mcp/instruction.md\",\"status\":\"added\",\"additions\":5,\"deletions\":0,\"changes\":5},{\"filename\":\"evals/harbor/hello-mcp/task.toml\",\"status\":\"added\",\"additions\":43,\"deletions\":0,\"changes\":43},{\"filename\":\"evals/harbor/hello-mcp/tests/test.sh\",\"status\":\"added\",\"additions\":14,\"deletions\":0,\"changes\":14},{\"filename\":\"judges/greeting.yaml\",\"status\":\"added\",\"additions\":28,\"deletions\":0,\"changes\":28},{\"filename\":\"package.json\",\"status\":\"added\",\"additions\":32,\"deletions\":0,\"changes\":32},{\"filename\":\"scripts/deploy-runtime.sh\",\"status\":\"added\",\"additions\":104,\"deletions\":0,\"changes\":104},{\"filename\":\"scripts/run-e2b.sh\",\"status\":\"added\",\"additions\":85,\"deletions\":0,\"changes\":85},{\"filename\":\"scripts/run-introspection.sh\",\"status\":\"added\",\"additions\":236,\"deletions\":0,\"changes\":236},{\"filename\":\"scripts/run-local.sh\",\"status\":\"added\",\"additions\":28,\"deletions\":0,\"changes\":28},{\"filename\":\"scripts/setup-introspection.sh\",\"status\":\"added\",\"additions\":123,\"deletions\":0,\"changes\":123}],\"patch\":\"diff --git a/.githooks/pre-commit b/.githooks/pre-commit\\nnew file mode 100755\\nindex 0000000..939aac7\\n--- /dev/null\\n+++ b/.githooks/pre-commit\\n@@ -0,0 +1,4 @@\\n+#!/usr/bin/env sh\\n+set -eu\\n+\\n+npm run check\\ndiff --git a/.github/workflows/recipe-validation.yml b/.github/workflows/recipe-validation.yml\\nnew file mode 100644\\nindex 0000000..b3f0740\\n--- /dev/null\\n+++ b/.github/workflows/recipe-validation.yml\\n@@ -0,0 +1,17 @@\\n+name: recipe validation\\n+\\n+on:\\n+  pull_request:\\n+  push:\\n+    branches: [main]\\n+\\n+permissions:\\n+  contents: read\\n+\\n+jobs:\\n+  recipe-check:\\n+    runs-on: ubuntu-latest\\n+    steps:\\n+      - uses: actions/checkout@v4\\n+\\n+      - uses: introspection-org/recipes-action@v0\\ndiff --git a/.gitignore b/.gitignore\\nnew file mode 100644\\nindex 0000000..0f1143d\\n--- /dev/null\\n+++ b/.gitignore\\n@@ -0,0 +1,20 @@\\n+# Generated Pi runtime state\\n+.pi/bin/\\n+.pi/mcp-session.json\\n+.pi/mcporter.json\\n+.pi/mcp-catalogs/\\n+.introspection/local.json\\n+\\n+# Local MCP binding: a Harbor trial writes it from task.toml; for\\n+# `introspection local`, copy in one of the .pi/*.example.json files.\\n+.pi/mcp.local.json\\n+\\n+# Dependencies\\n+node_modules/\\n+__pycache__/\\n+*.pyc\\n+\\n+# Secrets. `introspection dev` stages with `git add -A`, so anything untracked\\n+# and un-ignored here travels to the cloud inside the development patch.\\n+.env\\n+.env.*\\ndiff --git a/.introspection/hello-mcp-6af253eb-f07b.yaml b/.introspection/hello-mcp-6af253eb-f07b.yaml\\nnew file mode 100644\\nindex 0000000..0df52cd\\n--- /dev/null\\n+++ b/.introspection/hello-mcp-6af253eb-f07b.yaml\\n@@ -0,0 +1,10 @@\\n+name: hello-mcp-6af253eb-f07b\\n+path: .\\n+description: Harbor E2B task calling a development MCP server\\n+runtime:\\n+  llm_mode: managed\\n+  # Connector requirement: the `hello-mcp` project connector backs the\\n+  # `hello-mcp` MCP server declared in package.json. Not a credential — the\\n+  # Runtime page reuses or authorizes a connection and binds the endpoint.\\n+  connectors:\\n+    - hello-mcp\\ndiff --git a/.pi/mcp.local.example.json b/.pi/mcp.local.example.json\\nnew file mode 100644\\nindex 0000000..0bc8a34\\n--- /dev/null\\n+++ b/.pi/mcp.local.example.json\\n@@ -0,0 +1,9 @@\\n+{\\n+  \\\"servers\\\": [\\n+    {\\n+      \\\"id\\\": \\\"hello-mcp\\\",\\n+      \\\"transport\\\": \\\"streamable_http\\\",\\n+      \\\"url\\\": \\\"http://localhost:8000/mcp\\\"\\n+    }\\n+  ]\\n+}\\ndiff --git a/.pi/mcp.remote.example.json b/.pi/mcp.remote.example.json\\nnew file mode 100644\\nindex 0000000..8176c3c\\n--- /dev/null\\n+++ b/.pi/mcp.remote.example.json\\n@@ -0,0 +1,12 @@\\n+{\\n+  \\\"servers\\\": [\\n+    {\\n+      \\\"id\\\": \\\"hello-mcp\\\",\\n+      \\\"transport\\\": \\\"streamable_http\\\",\\n+      \\\"url\\\": \\\"https://example-server.modelcontextprotocol.io/mcp\\\",\\n+      \\\"headers\\\": {\\n+        \\\"Authorization\\\": \\\"Bearer ${HELLO_MCP_TOKEN}\\\"\\n+      }\\n+    }\\n+  ]\\n+}\\ndiff --git a/.recipeignore b/.recipeignore\\nnew file mode 100644\\nindex 0000000..989dcc9\\n--- /dev/null\\n+++ b/.recipeignore\\n@@ -0,0 +1,3 @@\\n+# Eval-only files never reach a deployed runtime. In a Harbor trial only the\\n+# task's environment/ reaches the agent.\\n+evals/\\ndiff --git a/README.md b/README.md\\nnew file mode 100644\\nindex 0000000..45965a7\\n--- /dev/null\\n+++ b/README.md\\n@@ -0,0 +1,282 @@\\n+# Harbor hello-mcp on Introspection\\n+\\n+A Harbor task whose agent is a Pi Recipe. The task talks to a `hello-mcp` MCP\\n+server, and the same Recipe, instruction and verifier run against two worlds:\\n+\\n+- **sidecar** (default): the MCP server declared in the task's own\\n+  `docker-compose.yaml` runs beside the agent. Locally that is a compose\\n+  container on Harbor's Docker provider; on the platform it is a sidecar of the\\n+  trial's sandbox pod, in-cluster under gVisor.\\n+- **remote**: the Runtime's `hello-mcp` connector binds the same id to the\\n+  authenticated public server, and the credential is injected at egress. This\\n+  is the integration check of the credential path, not the eval fixture.\\n+\\n+Nothing in the agent, the instruction, or the judge changes between the two.\\n+The Recipe declares one logical id, `hello-mcp`, and the binding decides what\\n+it resolves to.\\n+\\n+## The task contract\\n+\\n+```text\\n+evals/cases/hello-mcp.md               the case in the owner's words: situation, good and bad result\\n+evals/harbor/hello-mcp/                the Harbor task for that case, laid out as harbor/examples/tasks/<name>\\n+├── instruction.md                     the prompt\\n+├── task.toml                          Harbor task metadata, `[metadata] case`, `docker_image` + [[environment.mcp_servers]]\\n+├── environment/\\n+│   ├── docker-compose.yaml            the world: `main` (the agent slot) + `mcp-server`\\n+│   └── mcp-server/\\n+│       ├── Dockerfile                 the mcp-server image\\n+│       └── server.py                  FastMCP: `echo`, `get_greeting`\\n+└── tests/test.sh                      Harbor's verifier: reads /tmp/greeting.txt\\n+.recipeignore                          keeps `evals/` out of every deployed runtime\\n+judges/greeting.yaml                   the same check as tests/test.sh, over the trajectory\\n+agents/agent.yaml                      the Recipe agent; uses `hello-mcp` `echo`\\n+.pi/mcp.local.example.json             binds `hello-mcp` → http://localhost:8000/mcp (`introspection local`)\\n+.pi/mcp.remote.example.json            binds `hello-mcp` → the public server, token from HELLO_MCP_TOKEN (`introspection local`)\\n+.introspection/hello-mcp-local.yaml    Runtime manifest for the sidecar world\\n+.introspection/hello-mcp.yaml          Runtime manifest for the remote world (connector)\\n+```\\n+\\n+The task follows the Recipe format's default eval layout, which `\\\"evals\\\": {}`\\n+in `package.json` opts into, so `introspection check` also checks the link\\n+between the case and its task. The task's folder name is its case id,\\n+`hello-mcp`, and `[metadata] case` in `task.toml` states it as well.\\n+\\n+`docker-compose.yaml` is Harbor's shape and stays verbatim. The service named\\n+`main` is the agent: Harbor runs it from `task.toml`'s `docker_image` for a\\n+local trial, and the Introspection Runtime image fills the same slot for a\\n+platform trial, so `main` carries only `depends_on` and (if needed) `volumes`.\\n+The task carries no `environment/Dockerfile`: nothing on the platform would\\n+build it, so the Introspection Harbor adapter refuses a task that has one.\\n+Every other service is the world. On the platform each becomes a container of\\n+the sandbox pod, started before the agent in `depends_on` order, reached by its\\n+compose name on the pod's loopback, under the same gVisor sandbox and network\\n+policy as the agent, as a distinct non-root user with none of the runtime's\\n+platform environment. `build` is a local-only key: a sidecar is pulled from\\n+`image`, never built, so the image must be published somewhere the sandbox can\\n+pull from. See introspection-cloud `docs/design/eval-task-sidecars.md`.\\n+\\n+### How `hello-mcp` resolves\\n+\\n+The Recipe's `package.json` declares `hello-mcp` as a required MCP server. A\\n+Harbor trial binds it from the task itself, in `evals/harbor/hello-mcp/task.toml`:\\n+\\n+```toml\\n+[[environment.mcp_servers]]\\n+name = \\\"hello-mcp\\\"                  # the MCP server id the Recipe declares\\n+transport = \\\"streamable-http\\\"       # the only transport a Recipe binds\\n+url = \\\"http://mcp-server:8000/mcp\\\"  # the compose service name from docker-compose.yaml\\n+```\\n+\\n+Before the agent starts, the Introspection Harbor adapter writes these entries\\n+into the Recipe's `.pi/mcp.local.json` inside the trial, replacing anything the\\n+checkout carried. That happens on every Harbor run, local or on the platform,\\n+so the task is the single place the binding lives. See\\n+[docs/mcp-bindings.md](docs/mcp-bindings.md).\\n+\\n+The rule to follow: **`name` is the Recipe's MCP server id, and the `url` host\\n+is the service's name in `docker-compose.yaml`.** That name resolves in both\\n+places the task runs:\\n+\\n+- **Local Docker trial:** Docker Compose's DNS resolves each service name on the\\n+  compose network.\\n+- **Platform eval trial:** every compose service runs as a sidecar of the\\n+  sandbox pod, and the platform resolves each service name to the pod's\\n+  loopback, so the same URL connects unchanged.\\n+\\n+`localhost` would work on the platform only, since under Docker Compose it\\n+names the agent's own container.\\n+\\n+`introspection local` runs the Recipe on your machine, outside Harbor, and\\n+reads `.pi/mcp.local.json`, which is git-ignored. Copy in the example for the\\n+server you want.\\n+\\n+Against the hello server on your machine:\\n+\\n+```sh\\n+pip install \\\"fastmcp>=2.0,<3\\\"\\n+python evals/harbor/hello-mcp/environment/mcp-server/server.py &       # serves http://localhost:8000/mcp\\n+cp .pi/mcp.local.example.json .pi/mcp.local.json\\n+introspection local --runtime hello-mcp-local\\n+```\\n+\\n+Against the authenticated public server:\\n+\\n+```sh\\n+export HELLO_MCP_TOKEN=...\\n+cp .pi/mcp.remote.example.json .pi/mcp.local.json\\n+introspection local --runtime hello-mcp\\n+```\\n+\\n+The remote example carries a `${HELLO_MCP_TOKEN}` reference, never a token.\\n+A Harbor run ignores both files: it binds from `task.toml`.\\n+\\n+## The four ways to run this\\n+\\n+Same instruction, same Recipe, same judge — five places the trial can run. Only\\n+the first needs no Introspection plane at all, and the last is a contract check\\n+rather than a way to run the eval: it drives the image catalog, the compose gate\\n+and the commands surface through the raw API, which is what\\n+`IntrospectionEnvironment` will make redundant once it lands.\\n+\\n+| Shape | Script | Where the trial runs | How `hello-mcp` resolves |\\n+| --- | --- | --- | --- |\\n+| Local Docker | `./scripts/run-local.sh` | Harbor's Docker provider on your machine | `mcp-server` compose container; direct model + MCP calls from your keys |\\n+| Platform, sidecar | `introspection eval run --path evals/harbor/hello-mcp --runtime hello-mcp-local --runtime-version <id>` | in-cluster sandbox pod | `mcp-server` as a pod sidecar on loopback; its image built through `/v1/images` |\\n+| Platform, remote | `introspection eval run --path evals/harbor/hello-mcp --runtime hello-mcp --runtime-version <id>` | any provider, including E2B | the Runtime's connector binding; credential injected at egress |\\n+| E2B, host-driven | `./scripts/run-e2b.sh` | E2B sandbox, Harbor drives it from your machine | the Runtime's connector binding under managed egress, or `HELLO_MCP_TOKEN` |\\n+| Platform, contract check | `./scripts/run-eval-compose.sh` | in-cluster sandbox pod | `mcp-server` as a sidecar, built and addressed through the raw API rather than the adapter |\\n+\\n+**The platform rows need `IntrospectionEnvironment`** (introspection-cli#368),\\n+which builds each sidecar through `/v1/images`, substitutes the digest-pinned\\n+reference and posts the `kind: eval` task. This repo used to carry a\\n+`run-task.sh` doing that by hand, from before the adapter existed; it is gone,\\n+because two implementations of one sequence is one too many and only the\\n+adapter is maintained.\\n+\\n+**Compose worlds are a Kubernetes capability.** Only the in-cluster providers\\n+render a second container, so the sidecar shape pins the task in-cluster and an\\n+E2B trial gets the remote/connector world instead. That is not a gap to close\\n+casually: E2B has no pod, so there is no shared network namespace to put compose\\n+services on loopback. Running compose inside an E2B sandbox would mean\\n+docker-in-docker, which is the shape `images.md` set out to replace — it gives up\\n+digest pinning, scanning, content-dedup and provenance.\\n+\\n+### Order of operations\\n+\\n+```sh\\n+version=$(./scripts/deploy-runtime.sh)   # 1. a Runtime version, baked; prints its id\\n+./scripts/setup-introspection.sh         # 2. connector + binding (remote/E2B worlds only)\\n+introspection eval run --path evals/harbor/hello-mcp --runtime hello-mcp-local --runtime-version \\\"$version\\\"   # 3. run\\n+```\\n+\\n+`deploy-runtime.sh` takes `--manifest` to choose the world:\\n+`.introspection/hello-mcp-local.yaml` for the sidecar world (no connector),\\n+`.introspection/hello-mcp.yaml` for the connector world.\\n+\\n+The sidecar world needs a project API key carrying **both capability\\n+bundles**. `evals` covers `tasks:eval` for `kind: eval`, `images:write` for the\\n+sidecar image and `tasks:exec` for commands; `runtimes` covers the `files:write`\\n+that uploading the image's build context goes through, which `evals` does not\\n+include. A CLI login carries `runtimes` and `reviews` but never `evals`, so it\\n+cannot create a trial at all — and a key minted with `evals` alone gets as far\\n+as the context upload and fails there.\\n+\\n+## Run locally with Harbor\\n+\\n+`./scripts/run-local.sh` runs the task on Harbor's own Docker provider, with no\\n+Introspection plane involved: Docker Compose builds and starts `main` (the\\n+agent) and `mcp-server`, the agent calls your model provider directly, and\\n+Harbor's verifier (`tests/test.sh`) checks the result. A failure here is the\\n+task's or the Recipe's, not the platform's.\\n+\\n+You need Docker, Node.js 24 or newer, the Introspection CLI\\n+(`npm install -g @introspection-ai/cli`) and your model key (for example\\n+`ANTHROPIC_API_KEY`) in the environment. The script runs `introspection setup\\n+--target harbor` for you.\\n+\\n+```sh\\n+./scripts/run-local.sh\\n+```\\n+\\n+The adapter binds `hello-mcp` to `http://mcp-server:8000/mcp` from\\n+`task.toml`, so nothing needs copying into place first.\\n+\\n+## Run as an eval task on the platform\\n+\\n+Deploy the Recipe as a Runtime, once per world:\\n+\\n+```sh\\n+./scripts/setup-introspection.sh          # hello-mcp: connector + remote binding\\n+introspection runtimes deploy --manifest .introspection/hello-mcp-local.yaml\\n+```\\n+\\n+Then run the task. Every trial is a `kind: eval` task tagged `harbor`, created\\n+non-interactively: the instruction goes up through the Files API, the prompt\\n+is `@/workspace/files/instruction.md`, the runtime takes the one turn from the\\n+spawn env, judges the conversation when it settles, posts the result and ends.\\n+\\n+```sh\\n+export INTROSPECTION_DP_URL=...    # the data plane's API URL\\n+export INTROSPECTION_TOKEN=...     # project API key with the `evals` and `runtimes` capabilities\\n+version=$(./scripts/deploy-runtime.sh)\\n+introspection eval run --path evals/harbor/hello-mcp --runtime hello-mcp-local --runtime-version \\\"$version\\\"\\n+```\\n+\\n+`--runtime` names the manifest and `--runtime-version` the deployed version\\n+`deploy-runtime.sh` prints, so the run makes no Control Plane request and needs\\n+no `introspection login`. The adapter binds `hello-mcp` from `task.toml` here\\n+too.\\n+\\n+The environment sends the compose file as the task's `compose` field, minus\\n+`build`:\\n+\\n+```json\\n+{\\n+  \\\"runtime\\\": \\\"hello-mcp-local\\\",\\n+  \\\"kind\\\": \\\"eval\\\",\\n+  \\\"tags\\\": [\\\"harbor\\\"],\\n+  \\\"prompt\\\": \\\"@/workspace/files/instruction.md\\\",\\n+  \\\"files\\\": [{ \\\"id\\\": \\\"<file id>\\\", \\\"name\\\": \\\"instruction.md\\\" }],\\n+  \\\"metadata\\\": { \\\"interactive\\\": false },\\n+  \\\"compose\\\": {\\n+    \\\"services\\\": {\\n+      \\\"main\\\": { \\\"depends_on\\\": { \\\"mcp-server\\\": { \\\"condition\\\": \\\"service_healthy\\\" } } },\\n+      \\\"mcp-server\\\": {\\n+        \\\"image\\\": \\\"ghcr.io/introspection-org/recipe-harbor-mcp-agent/mcp-server:0.1.0\\\",\\n+        \\\"expose\\\": [\\\"8000\\\"],\\n+        \\\"environment\\\": { \\\"MCP_HOST\\\": \\\"0.0.0.0\\\", \\\"MCP_PORT\\\": \\\"8000\\\" },\\n+        \\\"healthcheck\\\": { \\\"test\\\": [\\\"CMD\\\", \\\"python\\\", \\\"-c\\\", \\\"…\\\"], \\\"interval\\\": \\\"2s\\\", \\\"timeout\\\": \\\"5s\\\", \\\"retries\\\": 15, \\\"start_period\\\": \\\"3s\\\" }\\n+      }\\n+    }\\n+  }\\n+}\\n+```\\n+\\n+No CLI command sends a `compose` document, so that path posts to\\n+`POST /v1/tasks` directly and needs `INTROSPECTION_TOKEN` (an API key carrying\\n+the `evals` capability, since `kind: eval` takes `tasks:eval`) and\\n+`INTROSPECTION_API_BASE_URL`. The remote world goes through\\n+`introspection tasks create`. The Harbor adapter reaches the same surface\\n+without a flag: `IntrospectionEnvironment` (introspection-cli#368) creates the\\n+trial with `kind`, `compose` and `commands` together over HTTP, which is why it\\n+does not shell out to the CLI.\\n+\\n+The reward is the `greeting` judge's verdict, read back as an\\n+`introspection.judgement` event, which is what a caller reads in place of\\n+Harbor's `reward.txt`. `tests/test.sh` is the same check for a local Harbor\\n+trial.\\n+\\n+## Remote world: connector setup\\n+\\n+The `hello-mcp` manifest declares the connector this runtime needs:\\n+\\n+```yaml\\n+runtime:\\n+  connectors:\\n+    - hello-mcp\\n+```\\n+\\n+Every deployed runtime version records it, and the Runtime page in the console\\n+shows **Connect hello-mcp** for any environment where the connector, its\\n+authorized connection, or the MCP binding is missing. `scripts/setup-introspection.sh`\\n+does the same through the CLI: it creates the connector, opens the initial\\n+authorization flow, and binds the endpoint. For a clean-room retry:\\n+\\n+```sh\\n+./scripts/setup-introspection.sh --teardown --yes\\n+```\\n+\\n+To reconnect later, or to verify the stored credential without printing it:\\n+\\n+```sh\\n+introspection connectors authorize hello-mcp --runtime hello-mcp\\n+introspection connectors connections list --connector hello-mcp -o table\\n+introspection connectors test hello-mcp --connection <connection-id>\\n+```\\n+\\n+`scripts/run-e2b.sh` drives an E2B sandbox from your machine for the remote\\n+world, booting the Runtime's published template. It is the one shape Harbor\\n+runs without the plane creating the sandbox, which is why it stays.\\n+\\n+Keep credentials in the ignored `.env`; never add them to this Recipe.\\ndiff --git a/agents/agent.yaml b/agents/agent.yaml\\nnew file mode 100644\\nindex 0000000..7a414e3\\n--- /dev/null\\n+++ b/agents/agent.yaml\\n@@ -0,0 +1,21 @@\\n+name: agent\\n+description: Calls the hello MCP for the Harbor task\\n+ai:\\n+  model: anthropic/claude-sonnet-5-5\\n+  thinking_level: low\\n+tools:\\n+  - read\\n+  - bash\\n+  - write\\n+mcp:\\n+  mode: tools\\n+  servers:\\n+    hello-mcp:\\n+      include:\\n+        - echo\\n+skills: []\\n+subagents: []\\n+system_instructions:\\n+  mode: append\\n+  content: |\\n+    Use the declared hello MCP whenever the task asks you to echo a message.\\ndiff --git a/agents/scripted.yaml b/agents/scripted.yaml\\nnew file mode 100644\\nindex 0000000..d690804\\n--- /dev/null\\n+++ b/agents/scripted.yaml\\n@@ -0,0 +1,25 @@\\n+# The same agent on the platform's scripted model double, so a run is\\n+# deterministic and costs nothing: each prompt carries a <<SCRIPT {...}>>\\n+# directive naming what a real model does on the instruction (introspection-cloud\\n+# docs/design/sdk-end-to-end-walk.md §2). Selected per task with agent_name.\\n+name: scripted\\n+description: Calls the hello MCP for the Harbor task, on the scripted model double\\n+ai:\\n+  model: introspection/scripted-llm\\n+  thinking_level: low\\n+tools:\\n+  - read\\n+  - bash\\n+  - write\\n+mcp:\\n+  mode: tools\\n+  servers:\\n+    hello-mcp:\\n+      include:\\n+        - echo\\n+skills: []\\n+subagents: []\\n+system_instructions:\\n+  mode: append\\n+  content: |\\n+    Use the declared hello MCP whenever the task asks you to echo a message.\\ndiff --git a/docs/mcp-bindings.md b/docs/mcp-bindings.md\\nnew file mode 100644\\nindex 0000000..5c0f86e\\n--- /dev/null\\n+++ b/docs/mcp-bindings.md\\n@@ -0,0 +1,77 @@\\n+# How `hello-mcp` is bound\\n+\\n+This Recipe declares one logical MCP server, `hello-mcp`, as required in\\n+`package.json`. The agent (`agents/agent.yaml`) only ever names that id. Which\\n+server the id reaches is a *binding*, and for a Harbor trial the binding is\\n+declared by the task, not the Recipe.\\n+\\n+## The task declares the binding\\n+\\n+`evals/harbor/hello-mcp/task.toml`:\\n+\\n+```toml\\n+[[environment.mcp_servers]]\\n+name = \\\"hello-mcp\\\"\\n+transport = \\\"streamable-http\\\"\\n+url = \\\"http://mcp-server:8000/mcp\\\"\\n+```\\n+\\n+- `name` is the MCP server id the Recipe declares.\\n+- `transport` must be `streamable-http`; a Recipe binds nothing else.\\n+- The URL's host is the service's name in `evals/harbor/hello-mcp/environment/docker-compose.yaml`.\\n+\\n+Before the agent starts, the Introspection Harbor adapter writes these entries\\n+into the Recipe's `.pi/mcp.local.json` inside the trial. It does this on every\\n+Harbor run, local or on the platform, and replaces anything the checkout\\n+carried. Nothing needs committing or copying into place.\\n+\\n+## Why the compose service name\\n+\\n+The same URL has to work in both places the task runs:\\n+\\n+| Where | How `mcp-server` resolves |\\n+| --- | --- |\\n+| Local Harbor Docker trial (`scripts/run-local.sh`) | Docker Compose's DNS resolves each service name on the compose network |\\n+| Platform eval trial | Each compose service runs as a sidecar of the sandbox pod, and the platform resolves each service name to the pod's loopback |\\n+\\n+`localhost` works on the platform only: under Docker Compose it names the\\n+agent's own container.\\n+\\n+On the platform, sidecars start before the agent in `depends_on` order, and the\\n+agent starts only once their healthchecks pass. Compose sidecars need a\\n+Kubernetes sandbox, so a task with a compose world always runs in-cluster.\\n+\\n+## Outside Harbor\\n+\\n+`introspection local` runs the Recipe on your machine, outside Harbor, and\\n+reads `.pi/mcp.local.json`, which is git-ignored. Copy in the example for the\\n+server you want.\\n+\\n+Against the hello server on your machine:\\n+\\n+```sh\\n+pip install \\\"fastmcp>=2.0,<3\\\"\\n+python evals/harbor/hello-mcp/environment/mcp-server/server.py &       # serves http://localhost:8000/mcp\\n+cp .pi/mcp.local.example.json .pi/mcp.local.json\\n+introspection local --runtime hello-mcp-local\\n+```\\n+\\n+Against the authenticated public server:\\n+\\n+```sh\\n+export HELLO_MCP_TOKEN=...\\n+cp .pi/mcp.remote.example.json .pi/mcp.local.json\\n+introspection local --runtime hello-mcp\\n+```\\n+\\n+The remote example carries a `${HELLO_MCP_TOKEN}` reference, never a token.\\n+A Harbor run ignores both files: it binds from `task.toml`.\\n+\\n+## Connector world\\n+\\n+A Runtime deployed from `.introspection/hello-mcp.yaml` has a `hello-mcp`\\n+connector. Its binding resolves the id to the authenticated public server, and\\n+the credential is injected at egress rather than placed in the sandbox. A\\n+non-Harbor task on that Runtime (`introspection tasks create`) uses it. A\\n+Harbor trial binds `hello-mcp` from `task.toml` instead, since the adapter's\\n+binding wins on an eval task.\\ndiff --git a/evals/cases/hello-mcp.md b/evals/cases/hello-mcp.md\\nnew file mode 100644\\nindex 0000000..0992ccc\\n--- /dev/null\\n+++ b/evals/cases/hello-mcp.md\\n@@ -0,0 +1,34 @@\\n+---\\n+id: hello-mcp\\n+title: The agent echoes a message through the hello MCP and saves the reply\\n+check: code\\n+sources: [hello-mcp]\\n+approved_by: \\\"Christoforus Yoga Haryanto <yoga@introspection.dev>\\\"\\n+approved_at: \\\"2026-11-05T12:15:03Z\\\"\\n+approved_in: \\\"introspection-org/recipe-harbor-mcp-agent#20\\\"\\n+approved_hash: \\\"sha256:3a22fe1af1da2dd186636c0b4eb10025b921e3e8a2a43a944244f7014cb3ca9c\\\"\\n+---\\n+\\n+## Situation\\n+\\n+The agent is asked to call the `echo` tool on the `hello-mcp` server with the\\n+message `hello from the public MCP`, and to save what comes back in\\n+`/tmp/greeting.txt`.\\n+\\n+## A good result\\n+\\n+`/tmp/greeting.txt` holds exactly what the tool sent back,\\n+`Echo: hello from the public MCP`, with no quotes or other formatting around it.\\n+\\n+## A bad result\\n+\\n+- The file is missing or empty.\\n+- The file holds the message the agent was given instead of the tool's reply,\\n+  which shows the tool was never called.\\n+- The reply is wrapped in quotes or extra text, or the agent made up a reply\\n+  instead of using the tool's.\\n+\\n+## Verification\\n+\\n+The task's verifier compares the file with the expected reply and scores 1 for\\n+an exact match, 0 otherwise.\\ndiff --git a/evals/harbor/hello-mcp/environment/docker-compose.yaml b/evals/harbor/hello-mcp/environment/docker-compose.yaml\\nnew file mode 100644\\nindex 0000000..c088c3e\\n--- /dev/null\\n+++ b/evals/harbor/hello-mcp/environment/docker-compose.yaml\\n@@ -0,0 +1,38 @@\\n+# The task's world, in Harbor's shape. `main` is the agent container: Harbor\\n+# runs it from task.toml's docker_image for a local Docker trial, and the\\n+# Introspection Runtime image fills the same slot when the trial runs as an\\n+# eval task, so `main` carries only what binds the agent to the world.\\n+#\\n+# Every other service is a sibling the agent reaches by service name. Locally\\n+# that is a compose container on the trial's network; on the platform it is a\\n+# sidecar of the sandbox pod, reached at the same URL through the pod's\\n+# loopback (introspection-cloud docs/design/eval-task-sidecars.md).\\n+services:\\n+  main:\\n+    depends_on:\\n+      mcp-server:\\n+        condition: service_healthy\\n+\\n+  mcp-server:\\n+    # Built from source. A local Harbor trial builds this context directly; the\\n+    # platform refuses `build` by key and pulls instead, so the image that same\\n+    # context produced through POST /v1/images is substituted here before the\\n+    # task is created.\\n+    #\\n+    # To pull a published server rather than build it, comment out `build` and\\n+    # uncomment `image`. Both together would name two sources for one service,\\n+    # and the published one does not exist yet.\\n+    build:\\n+      context: ./mcp-server\\n+    # image: ghcr.io/introspection-org/recipe-harbor-mcp-agent/mcp-server:0.1.0\\n+    expose:\\n+      - \\\"8000\\\"\\n+    environment:\\n+      MCP_HOST: 0.0.0.0\\n+      MCP_PORT: \\\"8000\\\"\\n+    healthcheck:\\n+      test: [\\\"CMD\\\", \\\"python\\\", \\\"-c\\\", \\\"import socket; socket.create_connection(('127.0.0.1', 8000), timeout=2).close()\\\"]\\n+      interval: 2s\\n+      timeout: 5s\\n+      retries: 15\\n+      start_period: 3s\\ndiff --git a/evals/harbor/hello-mcp/environment/mcp-server/Dockerfile b/evals/harbor/hello-mcp/environment/mcp-server/Dockerfile\\nnew file mode 100644\\nindex 0000000..9e4cda5\\n--- /dev/null\\n+++ b/evals/harbor/hello-mcp/environment/mcp-server/Dockerfile\\n@@ -0,0 +1,13 @@\\n+# The hello MCP server as a sidecar image: nothing but Python, FastMCP and\\n+# server.py, running as a non-root user so it satisfies the sandbox pod's\\n+# security context unchanged.\\n+FROM python:3.12-slim\\n+\\n+RUN pip install --no-cache-dir \\\"fastmcp>=2.0,<3\\\"\\n+\\n+WORKDIR /srv\\n+COPY server.py /srv/server.py\\n+\\n+USER 1001\\n+EXPOSE 8000\\n+CMD [\\\"python\\\", \\\"/srv/server.py\\\"]\\ndiff --git a/evals/harbor/hello-mcp/environment/mcp-server/server.py b/evals/harbor/hello-mcp/environment/mcp-server/server.py\\nnew file mode 100644\\nindex 0000000..5b9fbac\\n--- /dev/null\\n+++ b/evals/harbor/hello-mcp/environment/mcp-server/server.py\\n@@ -0,0 +1,35 @@\\n+\\\"\\\"\\\"The hello MCP server the Harbor task talks to when it runs as a sidecar.\\n+\\n+Deterministic on purpose: the verifier compares the agent's output against\\n+what `echo` returns. The same tools exist on the authenticated public server\\n+the connector-backed mode binds instead, so the instruction and the verifier\\n+are identical in both worlds.\\n+\\\"\\\"\\\"\\n+\\n+import os\\n+\\n+from fastmcp import FastMCP\\n+\\n+mcp = FastMCP(\\\"hello\\\")\\n+\\n+\\n+@mcp.tool()\\n+def echo(message: str) -> str:\\n+    \\\"\\\"\\\"Echo a message back, prefixed exactly as the public hello server does.\\\"\\\"\\\"\\n+\\n+    return f\\\"Echo: {message}\\\"\\n+\\n+\\n+@mcp.tool()\\n+def get_greeting() -> str:\\n+    \\\"\\\"\\\"Return a fixed greeting.\\\"\\\"\\\"\\n+\\n+    return \\\"hello from the local MCP\\\"\\n+\\n+\\n+if __name__ == \\\"__main__\\\":\\n+    mcp.run(\\n+        transport=\\\"streamable-http\\\",\\n+        host=os.environ.get(\\\"MCP_HOST\\\", \\\"127.0.0.1\\\"),\\n+        port=int(os.environ.get(\\\"MCP_PORT\\\", \\\"8000\\\")),\\n+    )\\ndiff --git a/evals/harbor/hello-mcp/instruction.md b/evals/harbor/hello-mcp/instruction.md\\nnew file mode 100644\\nindex 0000000..f4e342b\\n--- /dev/null\\n+++ b/evals/harbor/hello-mcp/instruction.md\\n@@ -0,0 +1,5 @@\\n+# Hello MCP\\n+\\n+Call the `echo` tool from the declared `hello-mcp` MCP server with the message\\n+`hello from the public MCP`. Write the echoed value exactly, with no quotes or\\n+additional formatting, to `/tmp/greeting.txt`.\\ndiff --git a/evals/harbor/hello-mcp/task.toml b/evals/harbor/hello-mcp/task.toml\\nnew file mode 100644\\nindex 0000000..02c689d\\n--- /dev/null\\n+++ b/evals/harbor/hello-mcp/task.toml\\n@@ -0,0 +1,43 @@\\n+schema_version = \\\"1.1\\\"\\n+\\n+[task]\\n+name = \\\"introspection/hello-mcp\\\"\\n+description = \\\"Call the hello MCP from a Harbor trial: a compose sidecar, or the authenticated public server\\\"\\n+authors = []\\n+keywords = [\\\"introspection\\\", \\\"mcp\\\", \\\"sidecar\\\"]\\n+\\n+# The case this task implements (evals/cases/hello-mcp.md). The folder name\\n+# already gives the same id; the key keeps it if the folder is ever renamed.\\n+[metadata]\\n+case = \\\"hello-mcp\\\"\\n+\\n+[verifier]\\n+timeout_sec = 60.0\\n+\\n+[agent]\\n+timeout_sec = 600.0\\n+\\n+[environment]\\n+# The agent container for a local Docker trial. An image, not a Dockerfile: on\\n+# the platform the Runtime image fills `main`, and the Introspection Harbor\\n+# adapter refuses an environment/Dockerfile that nothing there builds.\\n+docker_image = \\\"buildpack-deps:noble-curl\\\"\\n+build_timeout_sec = 600.0\\n+cpus = 1\\n+memory_mb = 2048\\n+storage_mb = 10240\\n+\\n+# The Recipe's `hello-mcp` server, bound by the Harbor adapter on every run.\\n+# `name` is the Recipe's MCP server id; the URL's host is the compose service\\n+# name, which resolves under Docker Compose and in the platform's sandbox pod.\\n+[[environment.mcp_servers]]\\n+name = \\\"hello-mcp\\\"\\n+transport = \\\"streamable-http\\\"\\n+url = \\\"http://mcp-server:8000/mcp\\\"\\n+args = []\\n+\\n+[verifier.env]\\n+\\n+[environment.env]\\n+\\n+[solution.env]\\ndiff --git a/evals/harbor/hello-mcp/tests/test.sh b/evals/harbor/hello-mcp/tests/test.sh\\nnew file mode 100755\\nindex 0000000..5d1d1fb\\n--- /dev/null\\n+++ b/evals/harbor/hello-mcp/tests/test.sh\\n@@ -0,0 +1,14 @@\\n+#!/bin/sh\\n+\\n+set -eu\\n+\\n+mkdir -p /logs/verifier\\n+\\n+if [ \\\"$(cat /tmp/greeting.txt 2>/dev/null || true)\\\" = \\\"Echo: hello from the public MCP\\\" ]; then\\n+  echo 1 > /logs/verifier/reward.txt\\n+  exit 0\\n+fi\\n+\\n+echo 0 > /logs/verifier/reward.txt\\n+echo \\\"expected /tmp/greeting.txt to contain the public MCP echo\\\" >&2\\n+exit 1\\ndiff --git a/judges/greeting.yaml b/judges/greeting.yaml\\nnew file mode 100644\\nindex 0000000..51bf715\\n--- /dev/null\\n+++ b/judges/greeting.yaml\\n@@ -0,0 +1,28 @@\\n+name: greeting\\n+description: Did the agent echo the message through the hello MCP and write it exactly?\\n+\\n+on:\\n+  - event: message\\n+    match:\\n+      role: assistant\\n+\\n+instructions: |\\n+  You are grading a single-turn task. The user asked the assistant to call the\\n+  `echo` tool on the declared `hello-mcp` MCP server with the message\\n+  \\\"hello from the public MCP\\\" and to write the echoed value, exactly and with\\n+  no extra formatting, to /tmp/greeting.txt.\\n+\\n+  Return `pass` only when all of the following hold in the trajectory:\\n+  1. The assistant called the hello-mcp `echo` tool (a tool call whose name\\n+     ends in `echo`) with the message \\\"hello from the public MCP\\\".\\n+  2. That tool call's result contains exactly \\\"Echo: hello from the public MCP\\\".\\n+  3. The assistant wrote a file at /tmp/greeting.txt whose content is exactly\\n+     \\\"Echo: hello from the public MCP\\\" (a trailing newline is acceptable), using\\n+     a write tool call or a shell command.\\n+\\n+  Return `fail` when any step is missing, the message differs, the assistant\\n+  fabricated the echo without calling the tool, or the file content differs.\\n+\\n+llm:\\n+  provider: anthropic\\n+  model: claude-sonnet-4-6\\ndiff --git a/package.json b/package.json\\nnew file mode 100644\\nindex 0000000..89f5c74\\n--- /dev/null\\n+++ b/package.json\\n@@ -0,0 +1,32 @@\\n+{\\n+  \\\"name\\\": \\\"hello-mcp\\\",\\n+  \\\"version\\\": \\\"0.1.0\\\",\\n+  \\\"private\\\": true,\\n+  \\\"type\\\": \\\"module\\\",\\n+  \\\"scripts\\\": {\\n+    \\\"check\\\": \\\"npx -y -p @introspection-ai/cli@latest introspection check\\\",\\n+    \\\"check:json\\\": \\\"npx -y -p @introspection-ai/cli@latest introspection check --output json\\\",\\n+    \\\"prepare\\\": \\\"git config core.hooksPath .githooks || true\\\"\\n+  },\\n+  \\\"peerDependencies\\\": {\\n+    \\\"@earendil-works/pi-agent-core\\\": \\\"*\\\",\\n+    \\\"@earendil-works/pi-ai\\\": \\\"*\\\",\\n+    \\\"@earendil-works/pi-coding-agent\\\": \\\"*\\\"\\n+  },\\n+  \\\"pi\\\": {\\n+    \\\"agents\\\": [\\\"./agents/*.yaml\\\"],\\n+    \\\"mcp\\\": {\\n+      \\\"servers\\\": [\\n+        {\\n+          \\\"id\\\": \\\"hello-mcp\\\",\\n+          \\\"required\\\": true,\\n+          \\\"tools\\\": {\\n+            \\\"include\\\": [\\\"echo\\\"],\\n+            \\\"exclude\\\": []\\n+          }\\n+        }\\n+      ]\\n+    },\\n+    \\\"evals\\\": {}\\n+  }\\n+}\\ndiff --git a/scripts/deploy-runtime.sh b/scripts/deploy-runtime.sh\\nnew file mode 100755\\nindex 0000000..4816626\\n--- /dev/null\\n+++ b/scripts/deploy-runtime.sh\\n@@ -0,0 +1,104 @@\\n+#!/bin/sh\\n+\\n+# Deploy this Recipe as a Runtime version and wait for its image to bake.\\n+#\\n+# This is the step every other script assumes has already happened, and none of\\n+# them do: `run-e2b.sh` reads the version's published E2B template out of\\n+# `image_build_metadata`, and a platform trial names the Runtime by slug and\\n+# lets the Data Plane resolve the latest ready version. Deploy first, then run.\\n+#\\n+# The manifest decides which world the Runtime serves, and therefore how the\\n+# agent reaches the hello MCP:\\n+#\\n+#   hello-mcp-local.yaml  the sidecar world. No connector: the MCP is a compose\\n+#                         service of the task, reached on the pod's loopback.\\n+#                         Pair with `introspection eval run --path evals/harbor/hello-mcp --runtime-version`.\\n+#   hello-mcp.yaml        the connector world. The Runtime carries the hello-mcp\\n+#                         binding and the credential is injected at egress, so\\n+#                         nothing on the host holds a token. Pair with\\n+#                         `run-e2b.sh`, or `introspection eval run --path evals/harbor/hello-mcp --runtime-version`.\\n+#\\n+# The connector itself, its authorization and the MCP binding are\\n+# `setup-introspection.sh`'s job, and only the connector world needs them.\\n+#\\n+# Usage: deploy-runtime.sh [--manifest PATH] [--wait-seconds N]\\n+\\n+set -eu\\n+\\n+manifest=${HELLO_MCP_MANIFEST:-.introspection/hello-mcp-local.yaml}\\n+wait_seconds=${HELLO_MCP_DEPLOY_TIMEOUT_SECONDS:-1800}\\n+\\n+while [ \\\"$#\\\" -gt 0 ]; do\\n+  case \\\"$1\\\" in\\n+    --manifest)\\n+      [ \\\"$#\\\" -ge 2 ] || { echo \\\"--manifest needs a path\\\" >&2; exit 2; }\\n+      manifest=$2\\n+      shift 2\\n+      ;;\\n+    --wait-seconds)\\n+      [ \\\"$#\\\" -ge 2 ] || { echo \\\"--wait-seconds needs a number\\\" >&2; exit 2; }\\n+      wait_seconds=$2\\n+      shift 2\\n+      ;;\\n+    *)\\n+      echo \\\"Usage: $0 [--manifest PATH] [--wait-seconds N]\\\" >&2\\n+      exit 2\\n+      ;;\\n+  esac\\n+done\\n+\\n+if [ ! -f \\\"$manifest\\\" ]; then\\n+  echo \\\"No manifest at $manifest.\\\" >&2\\n+  exit 2\\n+fi\\n+\\n+# A Runtime is created from the manifest against the Recipe's committed git\\n+# ref, so an uncommitted change is not what gets deployed.\\n+runtime=$(\\n+  introspection runtimes create \\\\\\n+    --manifest \\\"$manifest\\\" \\\\\\n+    --yes \\\\\\n+    --non-interactive \\\\\\n+    --query id \\\\\\n+    -o json | jq -r .\\n+)\\n+if [ -z \\\"$runtime\\\" ] || [ \\\"$runtime\\\" = null ]; then\\n+  echo \\\"Runtime creation from $manifest did not return an id.\\\" >&2\\n+  exit 1\\n+fi\\n+echo \\\"Created Runtime version $runtime from $manifest; waiting for the bake.\\\" >&2\\n+\\n+# The bake is the Data Plane's, projected back onto the version. `pending` is\\n+# the state before a claim exists, so it is not yet a failure to wait through.\\n+polls=$((wait_seconds / 10))\\n+[ \\\"$polls\\\" -gt 0 ] || polls=1\\n+status=\\\"\\\"\\n+for _ in $(seq 1 \\\"$polls\\\"); do\\n+  status=$(introspection runtimes get \\\"$runtime\\\" --query image_build_status -o json | jq -r .)\\n+  case \\\"$status\\\" in\\n+    ready|failed) break ;;\\n+  esac\\n+  sleep 10\\n+done\\n+\\n+if [ \\\"$status\\\" != ready ]; then\\n+  reason=$(introspection runtimes get \\\"$runtime\\\" --query image_build_error_message -o json | jq -r '. // \\\"no reason recorded\\\"')\\n+  echo \\\"Runtime $runtime ended the bake as '$status': $reason\\\" >&2\\n+  exit 1\\n+fi\\n+\\n+echo \\\"Runtime $runtime is ready.\\\" >&2\\n+\\n+# The external artifact is what an E2B trial boots from; a Runtime that serves\\n+# only in-cluster has none, which is not an error here.\\n+template=$(\\n+  introspection runtimes get \\\"$runtime\\\" \\\\\\n+    --query image_build_metadata.external_image_name \\\\\\n+    -o json | jq -r '. // empty'\\n+)\\n+if [ -n \\\"$template\\\" ]; then\\n+  echo \\\"External sandbox template: $template\\\" >&2\\n+fi\\n+\\n+# stdout is the id alone, so a caller can capture it.\\n+echo \\\"$runtime\\\"\\ndiff --git a/scripts/run-e2b.sh b/scripts/run-e2b.sh\\nnew file mode 100755\\nindex 0000000..82b00ee\\n--- /dev/null\\n+++ b/scripts/run-e2b.sh\\n@@ -0,0 +1,85 @@\\n+#!/bin/sh\\n+\\n+set -eu\\n+\\n+if [ \\\"$#\\\" -ne 0 ]; then\\n+  echo \\\"Usage: $0\\\" >&2\\n+  exit 2\\n+fi\\n+\\n+# Run the Harbor trial in an E2B sandbox, booting the Runtime's published\\n+# template. Nothing here touches the connector: deploying the Runtime is\\n+# `deploy-runtime.sh` and authorizing its hello-mcp connection is\\n+# `setup-introspection.sh`, so this script only runs what those produced.\\n+#\\n+# How the agent reaches the MCP, in precedence order:\\n+#   managed egress   INTROSPECTION_TOKEN + INTROSPECTION_PUBLIC_EGRESS_URL set:\\n+#                    the egress proxy injects the Runtime's own connector\\n+#                    credential, and no token travels from this host at all.\\n+#   HELLO_MCP_TOKEN  an explicit token for a direct run against the public\\n+#                    server, passed through to the trial.\\n+\\n+template=${E2B_TEMPLATE_ID:-}\\n+runtime=${HELLO_MCP_RUNTIME_ID:-}\\n+runtime_name=${HELLO_MCP_RUNTIME:-hello-mcp}\\n+\\n+query_scalar() {\\n+  \\\"$@\\\" -o table\\n+}\\n+\\n+if [ -z \\\"$runtime\\\" ] && [ -z \\\"$template\\\" ]; then\\n+  runtime=$(query_scalar introspection runtimes list \\\\\\n+    --runtime \\\"$runtime_name\\\" \\\\\\n+    --query \\\"sort_by([?contains(environments, 'production')], &created_at)[-1].id\\\")\\n+  if [ -z \\\"$runtime\\\" ] || [ \\\"$runtime\\\" = null ]; then\\n+    echo \\\"No production Runtime was found for $runtime_name; deploy one with ./scripts/deploy-runtime.sh.\\\" >&2\\n+    exit 1\\n+  fi\\n+fi\\n+\\n+if [ -z \\\"$template\\\" ]; then\\n+  template=$(\\n+    query_scalar introspection runtimes get \\\"$runtime\\\" \\\\\\n+      --query image_build_metadata.external_image_name\\n+  )\\n+  if [ -z \\\"$template\\\" ] || [ \\\"$template\\\" = null ]; then\\n+    echo \\\"Runtime $runtime has no published external sandbox artifact.\\\" >&2\\n+    exit 1\\n+  fi\\n+fi\\n+\\n+managed=false\\n+if [ -n \\\"${INTROSPECTION_TOKEN:-}\\\" ] && [ -n \\\"${INTROSPECTION_PUBLIC_EGRESS_URL:-}\\\" ]; then\\n+  managed=true\\n+fi\\n+\\n+if [ \\\"$managed\\\" != true ] && [ -z \\\"${HELLO_MCP_TOKEN:-}\\\" ]; then\\n+  echo \\\"Set INTROSPECTION_TOKEN + INTROSPECTION_PUBLIC_EGRESS_URL to let the platform\\\" >&2\\n+  echo \\\"inject the Runtime's hello-mcp credential at egress (./scripts/setup-introspection.sh\\\" >&2\\n+  echo \\\"authorizes it), or set HELLO_MCP_TOKEN for a direct run.\\\" >&2\\n+  exit 2\\n+fi\\n+\\n+# Under managed egress nothing needs to travel: the proxy injects both the\\n+# model key and the Runtime's hello-mcp credential. An explicit token still\\n+# wins, for a direct run against the public server.\\n+passthrough=\\\"\\\"\\n+if [ \\\"$managed\\\" != true ]; then\\n+  passthrough=\\\"ANTHROPIC_API_KEY,HELLO_MCP_TOKEN\\\"\\n+elif [ -n \\\"${HELLO_MCP_TOKEN:-}\\\" ]; then\\n+  passthrough=\\\"HELLO_MCP_TOKEN\\\"\\n+fi\\n+if [ -n \\\"$passthrough\\\" ]; then\\n+  export HELLO_MCP_TOKEN\\n+  export INTROSPECTION_HARBOR_PASSTHROUGH_ENV=\\\"$passthrough\\\"\\n+fi\\n+exec introspection eval run \\\\\\n+  --runner harbor \\\\\\n+  --runtime hello-mcp \\\\\\n+  --path evals/harbor/hello-mcp \\\\\\n+  --trials 1 \\\\\\n+  --yes \\\\\\n+  -- \\\\\\n+  --env introspection_harbor.environment:IntrospectionE2BEnvironment \\\\\\n+  --environment-kwarg \\\"template_name=$template\\\" \\\\\\n+  --environment-kwarg sandbox_timeout_seconds=3600\\ndiff --git a/scripts/run-introspection.sh b/scripts/run-introspection.sh\\nnew file mode 100755\\nindex 0000000..e34d7df\\n--- /dev/null\\n+++ b/scripts/run-introspection.sh\\n@@ -0,0 +1,236 @@\\n+#!/bin/sh\\n+\\n+# Exercise the platform's eval contract end to end, the way a Harbor trial does\\n+# it — against any plane, with nothing but curl.\\n+#\\n+#   1. build this task's mcp-server from its own compose `build.context`,\\n+#      through the Files API and POST /v1/images\\n+#   2. create a `kind: eval` task carrying that image as a compose service\\n+#   3. wait for the sandbox, then run two commands through\\n+#      POST /v1/tasks/{id}/commands: one *inside* the sidecar, and one *from\\n+#      the agent* reaching the sidecar by its compose name\\n+#\\n+# Every step is the real API and nothing is read off this machine, so the same\\n+# run works against a local stack, staging or production: point\\n+# INTROSPECTION_DP_URL at the plane and give it a key for that project. It\\n+# defaults to localhost because that is where it is cheapest to be wrong.\\n+#\\n+# `IntrospectionEnvironment` (introspection-cli#368) does this same sequence in\\n+# code for a real Harbor trial. This stays useful beside it: it needs no Harbor\\n+# install, no Recipe checkout on the plane, and it asserts the contract rather\\n+# than a trial's outcome — so when a trial misbehaves, this says whether the\\n+# platform or the Recipe is at fault.\\n+#\\n+# Needs a project API key with BOTH capability bundles: `evals` for tasks:eval,\\n+# tasks:exec and images:write, `runtimes` for files:write. A login has neither.\\n+\\n+set -eu\\n+\\n+usage() {\\n+  echo \\\"Usage: INTROSPECTION_TOKEN=... $0 --runtime-id <uuid> [--mirror <ref@sha256:...>] [--keep]\\\" >&2\\n+  exit 2\\n+}\\n+\\n+runtime_id=${HELLO_MCP_RUNTIME_ID:-}\\n+mirror=\\\"\\\"\\n+keep=false\\n+while [ \\\"$#\\\" -gt 0 ]; do\\n+  case \\\"$1\\\" in\\n+    --runtime-id) [ \\\"$#\\\" -ge 2 ] || usage; runtime_id=$2; shift 2 ;;\\n+    --mirror) [ \\\"$#\\\" -ge 2 ] || usage; mirror=$2; shift 2 ;;\\n+    --keep) keep=true; shift ;;\\n+    *) usage ;;\\n+  esac\\n+done\\n+\\n+: \\\"${INTROSPECTION_TOKEN:?set INTROSPECTION_TOKEN to an evals+runtimes API key}\\\"\\n+: \\\"${INTROSPECTION_DP_URL:=http://localhost:8002}\\\"\\n+[ -n \\\"$runtime_id\\\" ] || usage\\n+\\n+compose_file=${HELLO_MCP_COMPOSE:-evals/harbor/hello-mcp/environment/docker-compose.yaml}\\n+service=${HELLO_MCP_SERVICE:-mcp-server}\\n+\\n+api() {\\n+  method=$1; path=$2; shift 2\\n+  curl -sS -f -X \\\"$method\\\" \\\\\\n+    -H \\\"Authorization: Bearer $INTROSPECTION_TOKEN\\\" \\\\\\n+    -H \\\"Content-Type: application/json\\\" \\\\\\n+    \\\"$@\\\" \\\"$INTROSPECTION_DP_URL$path\\\"\\n+}\\n+\\n+# `POST /v1/files` is multipart, so it does not go through `api`.\\n+#\\n+# `encryption: false` puts the bytes in the raw blob store. Everything this\\n+# script uploads is a transfer file — a build context, a probe — that exists to\\n+# cross into the sandbox and is deleted after, so app-level encryption costs\\n+# time and buys nothing, and a large build context would exceed its limits\\n+# anyway. The Harbor adapter uploads the same way.\\n+upload_file() {\\n+  curl -sS -f -X POST \\\\\\n+    -H \\\"Authorization: Bearer $INTROSPECTION_TOKEN\\\" \\\\\\n+    -F \\\"file=@$1\\\" -F \\\"name=$2\\\" -F \\\"file_type=upload\\\" \\\\\\n+    -F 'metadata={\\\"encryption\\\": false, \\\"purpose\\\": \\\"harbor-transfer\\\"}' \\\\\\n+    \\\"$INTROSPECTION_DP_URL/v1/files\\\" | jq -r .id\\n+}\\n+\\n+# Transfer files are the caller's to remove: nothing sweeps them before the\\n+# project is deleted, and the `evals` capability carries `files:delete` for\\n+# exactly this.\\n+uploaded_files=\\\"\\\"\\n+forget_file() { uploaded_files=\\\"$uploaded_files $1\\\"; }\\n+cleanup_files() {\\n+  for id in $uploaded_files; do\\n+    api DELETE \\\"/v1/files/$id\\\" >/dev/null 2>&1 || true\\n+  done\\n+}\\n+\\n+scratch=$(mktemp -d)\\n+trap 'cleanup_files; rm -rf \\\"$scratch\\\"' EXIT\\n+\\n+if [ -n \\\"$mirror\\\" ]; then\\n+  # The other half of the catalog: copy an image that already exists somewhere\\n+  # else, by digest, instead of building one. Same row, same gate, same\\n+  # digest-pinned reference — only the source differs.\\n+  echo \\\"mirroring          $mirror\\\" >&2\\n+  image=$(api POST /v1/images -d \\\"$(jq -n --arg r \\\"$mirror\\\" \\\\\\n+    '{name: \\\"hello-mcp/mirrored\\\", source: {kind: \\\"mirror\\\", reference: $r}}')\\\")\\n+else\\n+  # The context is whatever the compose file points `build.context` at, resolved\\n+  # against the compose file's own directory the way Docker Compose resolves it.\\n+  context=$(python3 -c \\\"\\n+import os, yaml\\n+compose = '$compose_file'\\n+build = yaml.safe_load(open(compose))['services']['$service']['build']\\n+relative = build if isinstance(build, str) else build.get('context', '.')\\n+print(os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(compose)), relative)))\\\")\\n+  echo \\\"context            $context\\\" >&2\\n+  tar -czf \\\"$scratch/context.tar.gz\\\" -C \\\"$context\\\" .\\n+\\n+  file_id=$(upload_file \\\"$scratch/context.tar.gz\\\" context.tar.gz)\\n+  forget_file \\\"$file_id\\\"\\n+  echo \\\"context uploaded   file=$file_id\\\" >&2\\n+\\n+  image=$(api POST /v1/images -d \\\"$(jq -n --arg f \\\"$file_id\\\" \\\\\\n+    '{name: \\\"hello-mcp/mcp-server\\\", source: {kind: \\\"context\\\", file_id: $f, dockerfile: \\\"Dockerfile\\\"}}')\\\")\\n+fi\\n+image_id=$(printf '%s' \\\"$image\\\" | jq -r .id)\\n+status=\\\"\\\"\\n+for _ in $(seq 1 240); do\\n+  image=$(api GET \\\"/v1/images/$image_id\\\")\\n+  status=$(printf '%s' \\\"$image\\\" | jq -r .status)\\n+  case \\\"$status\\\" in ready|failed|evicted) break ;; esac\\n+  sleep 5\\n+done\\n+if [ \\\"$status\\\" != ready ]; then\\n+  echo \\\"image ended as '$status': $(printf '%s' \\\"$image\\\" | jq -r '.error // \\\"no reason recorded\\\"')\\\" >&2\\n+  exit 1\\n+fi\\n+# `pull_reference` is a property the API does not serialize; compose it.\\n+reference=$(printf '%s' \\\"$image\\\" | jq -r '\\\"\\\\(.image_ref)@\\\\(.image_digest)\\\"')\\n+echo \\\"image ready        $reference\\\" >&2\\n+echo \\\"scan               $(printf '%s' \\\"$image\\\" | jq -r '.scan_status') $(printf '%s' \\\"$image\\\" | jq -r '.scan_summary // \\\"\\\" | tostring')\\\" >&2\\n+\\n+# A mirrored base image has no server in it, so it is given the same job the\\n+# built one does — otherwise \\\"the agent reached the sidecar\\\" would be asserting\\n+# against a container that exited on start.\\n+command_json=null\\n+if [ -n \\\"$mirror\\\" ]; then\\n+  command_json='[\\\"python\\\",\\\"-m\\\",\\\"http.server\\\",\\\"8000\\\"]'\\n+fi\\n+\\n+task=$(api POST /v1/tasks -d \\\"$(jq -n --arg r \\\"$runtime_id\\\" --arg i \\\"$reference\\\" --arg s \\\"$service\\\" --argjson cmd \\\"$command_json\\\" '{\\n+  runtime_id: $r, kind: \\\"eval\\\", tags: [\\\"eval-compose-smoke\\\"],\\n+  prompt: \\\"Wait quietly.\\\", metadata: {interactive: false}, commands: true,\\n+  compose: {services: ({main: {depends_on: {($s): {condition: \\\"service_healthy\\\"}}}} + {($s): ({\\n+    image: $i, expose: [\\\"8000\\\"],\\n+    healthcheck: {test: [\\\"CMD\\\",\\\"python\\\",\\\"-c\\\",\\\"import socket; socket.create_connection((\\\\\\\"127.0.0.1\\\\\\\", 8000), timeout=2)\\\"],\\n+                  interval: \\\"2s\\\", retries: 15, start_period: \\\"2s\\\"}}\\n+    + (if $cmd == null then {} else {command: $cmd} end))})}}')\\\")\\n+task_id=$(printf '%s' \\\"$task\\\" | jq -r '.task.id')\\n+echo \\\"eval task created  task=$task_id\\\" >&2\\n+\\n+# Commands need a live sandbox; anything earlier is a 409 by design.\\n+for _ in $(seq 1 100); do\\n+  state=$(api GET \\\"/v1/tasks/$task_id\\\" | jq -r .status)\\n+  case \\\"$state\\\" in\\n+    awaiting_user|idle|running) break ;;\\n+    failed|cancelled|completed) echo \\\"task reached $state without a sandbox\\\" >&2; exit 1 ;;\\n+  esac\\n+  sleep 3\\n+done\\n+echo \\\"sandbox up         status=$state\\\" >&2\\n+\\n+command_of() {\\n+  id=$(api POST \\\"/v1/tasks/$task_id/commands\\\" -d \\\"$1\\\" | jq -r .id)\\n+  for _ in $(seq 1 40); do\\n+    row=$(api GET \\\"/v1/tasks/$task_id/commands/$id\\\")\\n+    case \\\"$(printf '%s' \\\"$row\\\" | jq -r .status)\\\" in\\n+      succeeded|completed|failed|cancelled) printf '%s' \\\"$row\\\"; return ;;\\n+    esac\\n+    sleep 3\\n+  done\\n+  echo \\\"command stayed pending\\\" >&2\\n+  exit 1\\n+}\\n+\\n+inside=$(command_of \\\"$(jq -n --arg s \\\"$service\\\" '{kind:\\\"exec\\\", service:$s, command:[\\\"sh\\\",\\\"-c\\\",\\\"id -u\\\"], timeout_seconds:30}')\\\")\\n+echo \\\"exec in $service   exit=$(printf '%s' \\\"$inside\\\" | jq -r .exit_code) uid=$(printf '%s' \\\"$inside\\\" | jq -r '.stdout // \\\"\\\" | rtrimstr(\\\"\\\\n\\\")')\\\" >&2\\n+\\n+reach=$(command_of \\\"$(jq -n --arg s \\\"$service\\\" '{kind:\\\"exec\\\", command:[\\\"sh\\\",\\\"-c\\\",\\\"curl -s -o /dev/null -w %{http_code} http://\\\\($s):8000/\\\"], timeout_seconds:30}')\\\")\\n+http=$(printf '%s' \\\"$reach\\\" | jq -r '.stdout // \\\"\\\" | rtrimstr(\\\"\\\\n\\\")')\\n+echo \\\"agent -> $service  exit=$(printf '%s' \\\"$reach\\\" | jq -r .exit_code) http=$http\\\" >&2\\n+\\n+# The transfer commands, which is what a Harbor trial uses to stage inputs and\\n+# collect what the verifier wrote. Both ride the same exec channel as above —\\n+# no image of ours serves a file API — so a round trip is the honest check:\\n+# upload a known blob, read it back from inside the sandbox, download it again.\\n+probe=\\\"introspection round trip $(date -u +%s)\\\"\\n+printf '%s' \\\"$probe\\\" > \\\"$scratch/probe.txt\\\"\\n+probe_file=$(upload_file \\\"$scratch/probe.txt\\\" probe.txt)\\n+forget_file \\\"$probe_file\\\"\\n+\\n+staged=$(command_of \\\"$(jq -n --arg f \\\"$probe_file\\\" '{kind:\\\"upload\\\", file_id:$f, path:\\\"/tmp/probe.txt\\\"}')\\\")\\n+echo \\\"upload             status=$(printf '%s' \\\"$staged\\\" | jq -r .status)\\\" >&2\\n+\\n+readback=$(command_of '{\\\"kind\\\":\\\"exec\\\",\\\"command\\\":[\\\"cat\\\",\\\"/tmp/probe.txt\\\"],\\\"timeout_seconds\\\":30}')\\n+seen=$(printf '%s' \\\"$readback\\\" | jq -r '.stdout // \\\"\\\"')\\n+\\n+collected=$(command_of '{\\\"kind\\\":\\\"download\\\",\\\"path\\\":\\\"/tmp/probe.txt\\\"}')\\n+output_file=$(printf '%s' \\\"$collected\\\" | jq -r '.output_file_id // empty')\\n+echo \\\"download           status=$(printf '%s' \\\"$collected\\\" | jq -r .status) file=${output_file:-none}\\\" >&2\\n+\\n+returned=\\\"\\\"\\n+if [ -n \\\"$output_file\\\" ]; then\\n+  returned=$(curl -sS -f -H \\\"Authorization: Bearer $INTROSPECTION_TOKEN\\\" \\\\\\n+    \\\"$INTROSPECTION_DP_URL/v1/files/$output_file/content\\\" || true)\\n+  forget_file \\\"$output_file\\\"\\n+fi\\n+\\n+if [ \\\"$keep\\\" != true ]; then\\n+  api DELETE \\\"/v1/tasks/$task_id\\\" >/dev/null\\n+  echo \\\"task deleted\\\" >&2\\n+fi\\n+\\n+# What is being proved is that the agent reached the sidecar, not what the\\n+# sidecar serves at `/` — this server answers 404 there, and a plain file\\n+# server would answer 200. The failure to catch is the egress proxy answering\\n+# instead, which it does with a gateway 5xx for a name it cannot route: that is\\n+# what a missing NO_PROXY entry looks like from here.\\n+case \\\"$http\\\" in\\n+  50[234])   echo \\\"FAILED: $http came from the egress proxy, not the sidecar\\\" >&2; exit 1 ;;\\n+  \\\"\\\"|000)    echo \\\"FAILED: the agent never reached $service (curl reported '${http:-nothing}')\\\" >&2; exit 1 ;;\\n+esac\\n+\\n+# What was uploaded has to be what the sandbox holds, and what comes back has to\\n+# be what was uploaded. Comparing bytes rather than statuses is the point: a\\n+# transfer that reports success and truncates is the failure worth catching.\\n+case \\\"$seen\\\" in\\n+  *\\\"$probe\\\"*) ;;\\n+  *) echo \\\"FAILED: the sandbox does not hold what was uploaded (read '$seen')\\\" >&2; exit 1 ;;\\n+esac\\n+if [ \\\"$returned\\\" != \\\"$probe\\\" ]; then\\n+  echo \\\"FAILED: the download returned '${returned:-nothing}', not what was uploaded\\\" >&2\\n+  exit 1\\n+fi\\n+\\n+echo \\\"OK\\\" >&2\\ndiff --git a/scripts/run-local.sh b/scripts/run-local.sh\\nnew file mode 100755\\nindex 0000000..affc1e8\\n--- /dev/null\\n+++ b/scripts/run-local.sh\\n@@ -0,0 +1,28 @@\\n+#!/bin/sh\\n+\\n+# Run the Harbor task on Harbor's own Docker provider, with no Introspection\\n+# plane involved at all.\\n+#\\n+# This is the shape that verifies the task itself: `docker compose` brings up\\n+# `main` from task.toml's docker_image and `mcp-server` from its build context,\\n+# on a compose network, and Harbor's verifier reads the result. Nothing here\\n+# uploads an image, creates a task, or needs a credential beyond the model key\\n+# the agent uses — so a failure here is the task's, not the platform's.\\n+#\\n+# The Harbor adapter binds the Recipe's `hello-mcp` from task.toml's\\n+# [[environment.mcp_servers]], so there is no binding file to put in place.\\n+\\n+set -eu\\n+\\n+if [ \\\"$#\\\" -ne 0 ]; then\\n+  echo \\\"Usage: $0\\\" >&2\\n+  exit 2\\n+fi\\n+\\n+task=${HELLO_MCP_TASK:-evals/harbor/hello-mcp}\\n+\\n+# `eval run` infers the runner from the path: a directory holding task.toml is\\n+# a Harbor task. `--runtime` is required because two manifests share this\\n+# directory; both describe the same Recipe, so either serves a local run.\\n+introspection setup --target harbor --yes\\n+exec introspection eval run --path \\\"$task\\\" --runtime hello-mcp-local\\ndiff --git a/scripts/setup-introspection.sh b/scripts/setup-introspection.sh\\nnew file mode 100755\\nindex 0000000..30df5bc\\n--- /dev/null\\n+++ b/scripts/setup-introspection.sh\\n@@ -0,0 +1,123 @@\\n+#!/bin/sh\\n+\\n+set -eu\\n+\\n+mode=setup\\n+yes=false\\n+for arg in \\\"$@\\\"; do\\n+  case \\\"$arg\\\" in\\n+    --teardown) mode=teardown ;;\\n+    --yes) yes=true ;;\\n+    *) echo \\\"Usage: $0 [--teardown] [--yes]\\\" >&2; exit 2 ;;\\n+  esac\\n+done\\n+\\n+connector=${HELLO_MCP_CONNECTOR:-hello-mcp}\\n+runtime=${HELLO_MCP_RUNTIME_ID:-}\\n+runtime_group=${HELLO_MCP_RUNTIME:-hello-mcp}\\n+issuer=https://example-server.modelcontextprotocol.io/\\n+endpoint=https://example-server.modelcontextprotocol.io/mcp\\n+\\n+if [ \\\"$mode\\\" = teardown ]; then\\n+  bindings=$(\\n+    introspection bindings mcp list \\\\\\n+      --runtime \\\"$runtime_group\\\" \\\\\\n+      --environment development \\\\\\n+      -o json 2>/dev/null || printf '[]'\\n+  )\\n+  endpoint_ids=$(printf '%s' \\\"$bindings\\\" | jq -r --arg id \\\"$connector\\\" '.[] | select(.mcp_server_id == $id and .endpoint_id != null) | .endpoint_id')\\n+  runtimes=$(introspection runtimes list --runtime \\\"$runtime_group\\\" -o json 2>/dev/null || printf '[]')\\n+  runtime_ids=$(printf '%s' \\\"$runtimes\\\" | jq -r '.[].id')\\n+\\n+  echo \\\"Teardown targets:\\\" >&2\\n+  echo \\\"  connector: $connector (including its connections)\\\" >&2\\n+  if [ -n \\\"$endpoint_ids\\\" ]; then\\n+    printf '%s\\\\n' \\\"$endpoint_ids\\\" | sed 's/^/  endpoint: /' >&2\\n+  fi\\n+  if [ -n \\\"$runtime_ids\\\" ]; then\\n+    printf '%s\\\\n' \\\"$runtime_ids\\\" | sed 's/^/  runtime: /' >&2\\n+  fi\\n+\\n+  if [ \\\"$yes\\\" != true ]; then\\n+    if [ ! -t 0 ]; then\\n+      echo \\\"Refusing non-interactive teardown without --yes.\\\" >&2\\n+      exit 2\\n+    fi\\n+    printf \\\"Delete these hello-mcp resources? [y/N] \\\" >&2\\n+    read -r answer\\n+    case \\\"$answer\\\" in\\n+      y|Y|yes|YES) ;;\\n+      *) echo \\\"Teardown cancelled.\\\" >&2; exit 0 ;;\\n+    esac\\n+  fi\\n+\\n+  for endpoint_id in $endpoint_ids; do\\n+    introspection bindings mcp disconnect --endpoint \\\"$endpoint_id\\\" --yes --non-interactive -o json >/dev/null\\n+  done\\n+  if introspection connectors get \\\"$connector\\\" -o json >/dev/null 2>&1; then\\n+    introspection connectors delete \\\"$connector\\\" --yes --non-interactive -o json >/dev/null\\n+  fi\\n+  for runtime_id in $runtime_ids; do\\n+    if introspection runtimes get \\\"$runtime_id\\\" -o json >/dev/null 2>&1; then\\n+      introspection runtimes delete \\\"$runtime_id\\\" --yes --non-interactive -o json >/dev/null\\n+    fi\\n+  done\\n+  echo \\\"hello-mcp connector, bindings, and Runtime versions deleted.\\\" >&2\\n+  exit 0\\n+fi\\n+\\n+if [ -z \\\"$runtime\\\" ]; then\\n+  runtime=$(\\n+    introspection runtimes create \\\\\\n+      --yes \\\\\\n+      --non-interactive \\\\\\n+      --query id \\\\\\n+      -o json | jq -r .\\n+  )\\n+  if [ -z \\\"$runtime\\\" ] || [ \\\"$runtime\\\" = null ]; then\\n+    echo \\\"Runtime creation did not return an id; set HELLO_MCP_RUNTIME_ID explicitly.\\\" >&2\\n+    exit 1\\n+  fi\\n+  echo \\\"Created hello-mcp Runtime $runtime.\\\" >&2\\n+fi\\n+\\n+introspection connectors create \\\\\\n+  --name \\\"$connector\\\" \\\\\\n+  --provider \\\"$connector\\\" \\\\\\n+  --auth-mode oauth-stored \\\\\\n+  --issuer \\\"$issuer\\\" \\\\\\n+  --api-host example-server.modelcontextprotocol.io \\\\\\n+  --non-interactive \\\\\\n+  -o json >/dev/null\\n+\\n+introspection bindings mcp connect \\\\\\n+  --runtime \\\"$runtime_group\\\" \\\\\\n+  --mcp-server-id \\\"$connector\\\" \\\\\\n+  --endpoint-url \\\"$endpoint\\\" \\\\\\n+  --connector \\\"$connector\\\" \\\\\\n+  --name \\\"$connector\\\" \\\\\\n+  --non-interactive \\\\\\n+  -o json >/dev/null\\n+\\n+echo \\\"Connector and Runtime MCP binding are ready. Starting initial authorization...\\\" >&2\\n+introspection connectors authorize \\\\\\n+  \\\"$connector\\\" \\\\\\n+  --runtime \\\"$runtime_group\\\" \\\\\\n+  -o report\\n+\\n+connection=$(\\n+  introspection connectors connections list \\\\\\n+    --connector \\\"$connector\\\" \\\\\\n+    -o json | jq -r 'sort_by(.updated_at) | last | .id // empty'\\n+)\\n+if [ -z \\\"$connection\\\" ]; then\\n+  echo \\\"Authorization completed without returning a connection.\\\" >&2\\n+  exit 1\\n+fi\\n+\\n+echo \\\"Testing authorized MCP connection $connection...\\\" >&2\\n+introspection connectors test \\\\\\n+  \\\"$connector\\\" \\\\\\n+  --connection \\\"$connection\\\" \\\\\\n+  -o json >/dev/null\\n+echo \\\"Authorization and MCP discovery succeeded.\\\" >&2\\n\"}"
          },
