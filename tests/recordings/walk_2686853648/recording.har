 offset/limit for large files. When you need the full file, continue with offset until complete.\",\"parameters\":{\"properties\":{\"limit\":{\"description\":\"Maximum number of lines to read\",\"type\":\"number\"},\"offset\":{\"description\":\"Line number to start reading from (1-indexed)\",\"type\":\"number\"},\"path\":{\"description\":\"Path to the file to read (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"bash\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\",\"parameters\":{\"properties\":{\"command\":{\"description\":\"Shell command to execute\",\"type\":\"string\"},\"timeout\":{\"description\":\"Timeout in seconds (optional, no default timeout)\",\"type\":\"number\"}},\"required\":[\"command\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"write\",\"description\":\"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.\",\"parameters\":{\"properties\":{\"content\":{\"description\":\"Content to write to the file\",\"type\":\"string\"},\"path\":{\"description\":\"Path to the file to write (relative or absolute)\",\"type\":\"string\"}},\"required\":[\"path\",\"content\"],\"type\":\"object\"},\"type\":\"function\"},{\"name\":\"mcp_hello-mcp_echo_921a5a7771\",\"description\":\"Echoes back the input\",\"parameters\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"message\":{\"description\":\"Message to echo\",\"type\":\"string\"}},\"required\":[\"message\"],\"type\":\"object\"},\"type\":\"function\"}]},\"input\":{\"messages\":[{\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"content\":\"Reply with the single word done. <<SCRIPT {\\\"reply\\\":\\\"done\\\"}>>\"}]}]},\"output\":{\"messages\":[{\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"content\":\"done\"}],\"finish_reason\":\"stop\",\"provider\":\"introspection\",\"model\":\"scripted-llm\",\"api\":\"openai-completions\",\"response_id\":\"chatcmpl-47c936c0be2949a797c75a8282d298fe\"}]},\"system_instructions\":[{\"type\":\"text\",\"content\":\"Use the declared hello MCP whenever the task asks you to echo a message.\\n## Managed workspace\\n\\n<workspace>\\n  <inputs path=\\\"/workspace/files\\\" access=\\\"read_write\\\" persistence=\\\"task\\\" />\\n  <outputs path=\\\"/workspace/outputs\\\" persistence=\\\"task\\\" />\\n  Save downloaded source material under files/ and deliverables under outputs/. Mounted uploads and recipe files remain read-only; use a new path for modified copies.\\n</workspace>\\nUploaded inputs are read-only. Put intentional task deliverables in the outputs path so the platform can persist them.\\n\\n\\n## Session\\n\\n<session visibility=\\\"project\\\">\\n  <permissions plane=\\\"data\\\">annotations:read conversations:read events:read files:read files:write metrics:read shares:read shares:write tasks:read tasks:write repositories:write telemetry:write git:read</permissions>\\n</session>\\n\\n<cwd>\\n/workspace\\n</cwd>\"}]},\"introspection\":{\"agent\":{\"depth\":\"0\",\"kind\":\"session\"},\"byok\":false,\"contains\":{\"values\":[\"gen_ai.input.messages.role:user\",\"gen_ai.output.messages.parts.type:text\"],\"version\":1},\"environment\":\"production\",\"member\":{\"id\":\"01a16a8d-5e7c-72b0-bbaf-54c77c10080a\"},\"org\":{\"id\":\"01a16a8d-5e5b-749d-953c-25ef04696385\"},\"project\":{\"id\":\"01a16a8d-5e8e-76ca-88f7-401338c97e70\"},\"recipe\":{\"git_commit_sha\":\"543b8db50a839029b03d7ca7957884d806df646c\"},\"run\":{\"id\":\"01a16a8d-c307-73e4-8a4c-f812551327b5\",\"root_id\":\"01a16a8d-b42d-701a-a3d6-bbdaad33539d\"},\"runtime\":{\"group_id\":\"01a16a8d-726e-74bf-9f1b-5467d30152a0\",\"id\":\"01a16a8d-8