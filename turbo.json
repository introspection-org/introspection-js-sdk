{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CLAUDE_CODE_SESSION_ID",
    "CODEX_THREAD_ID",
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "INTROSPECTION_BASE_API_URL",
    "INTROSPECTION_BASE_OTEL_URL",
    "INTROSPECTION_DEV_TARGET",
    "INTROSPECTION_EGRESS_URL",
    "INTROSPECTION_ENDPOINT_HOSTS",
    "INTROSPECTION_LOG_LEVEL",
    "INTROSPECTION_PLUGIN_TELEMETRY",
    "INTROSPECTION_SERVICE_NAME",
    "INTROSPECTION_STRICT_TRACING",
    "INTROSPECTION_TOKEN",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
